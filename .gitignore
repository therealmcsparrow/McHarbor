# Project-specific Git ignore rules.
# Editor/OS/tooling noise lives in the user-level global ignore file:
#   ~/.config/git/ignore  (git default when core.excludesFile is unset)

# Dependencies
node_modules/

# Build output
*.exe
.tools
dist/
tsconfig.tsbuildinfo

# Compiled binaries — anchored, so a future source directory named
# "mcharbor" is not swallowed by a bare pattern.
/mcharbor
/src/mcharbor
/src/backend/mcharbor
/src/agent/mcharbor-agent
# Built agent binaries (make agent / make agent-cross). The directory is
# kept; the binaries are build output.
/agents/*
!/agents/.gitkeep
!/agents/BUILD
!/agents/VERSION
# Secrets
/signing/*
/secrets/*

# Test output
coverage/
test-results/
playwright-report/
.results/

# Go
src/backend/vendor/

# Environment & secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12

# Runtime state — SQLite, TLS key material, widget and custom-node stores.
# These were covered only by the user-level global ignore, which no clone has.
src/backend/data/

# Database
*.db
*.db-journal
*.db-wal
*.db-shm

# Logs
*.log

# Docker build cache
.docker/

# Temp
tmp/
.devdocs/
.tmp_c.jar

# Development temps
backupagent.md
backuplocal.md
cookies.txt
/cli/*
!/cli/.gitkeep
/scripts/*
!/scripts/sanity/
!/scripts/hooks/
!/scripts/lint/
.tmp_c.jar

# AI-Sanity
src/**/CLAUDE.md
src/**/AGENTS.md
src/**/GEMINI.md
src/**/.claude/
src/**/.cursorrules
src/**/.cursor/
src/**/AI-*.md

/.instructions/
/src/agent/mcharbor-agent
