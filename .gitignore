# Project-specific Git ignore rules.
# Put editor/OS noise in a user-level global ignore file instead:
# git config --global core.excludesFile "$HOME/.gitignore_global"

# Dependencies
node_modules/
src/frontend/node_modules/

# Build output
src/frontend/dist/
*.exe
mcharbor

# Go
src/backend/vendor/

# Environment & secrets
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*.crt
*.p12

# Database
/data/
mnt/backup/
*.db
*.db-journal
*.db-wal
*.db-shm

# Testing
coverage/
test-results/
.results/
*_test.go
*.test.ts*
tests/

# Logs
*.log

# Docker build cache
.docker/

# Temp
tmp/
.tmp/
*.tsbuildinfo
roadmap.md

# Marketing
# The standalone website is excluded from the app build context, but the site
# pages and assets themselves are versioned.
website/*
services/*
