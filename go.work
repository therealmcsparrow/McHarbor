// Workspace only used at Docker build time. The plugin's `go.mod`
// declares a `replace` directive pointing at ../../../backend that
// works on a developer workstation, but the per-package ABI hashes
// still drift between the host's executable build and the plugin's
// plugin build because Go walks the module graph twice. Joining the
// two modules into a single workspace makes Go treat them as one
// graph and the package hashes match.
go 1.27.2

use (
	./src/backend
	./src/plugins/Plugins/addon-compute
	./src/plugins/Plugins/addon-kubernetes
	./src/plugins/Plugins/addon-kvm
	./src/plugins/Plugins/addon-lxc
	./src/plugins/Plugins/addon-reporting
	./src/plugins/Plugins/addon-swarm
	./src/plugins/Plugins/ai-provider-anthropic
