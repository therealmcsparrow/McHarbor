	./src/plugins/Plugins/ai-provider-fireworks
	./src/plugins/Plugins/ai-provider-gemini
	./src/plugins/Plugins/ai-provider-groq
	./src/plugins/Plugins/ai-provider-llamacpp
	./src/plugins/Plugins/ai-provider-lmstudio
