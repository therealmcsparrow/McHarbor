/**
 * example-plugin frontend UMD entry.
 *
 * Renders a single text field ("greeting") with a label and help
 * text. The host loads this bundle via
 * `window.McharborPlugin_example_plugin.mount(el, ctx)` and
 * pushes the canonical `<PluginSlot slot="plugin.config_form.example-plugin">`
 * outlet at the plugin's settings row.
 *
 * The bundle name is slug-derived:
 *   window.McharborPlugin_<slug_with_underscores> = { mount, ... }
 */

import { type Root } from 'react-dom/client';
import { guardedRoot } from './mountGuard';

type MountCtx = {
  value: Record<string, string>;
  onChange: (v: Record<string, string>) => void;
  onError?: (field: string, msg: string | null) => void;
  t?: (key: string, vars?: Record<string, unknown>) => string;
};

let root: Root | null = null;
let currentCtx: MountCtx | null = null;

function render() {
  if (!root || !currentCtx) return;
  const { value, onChange, onError, t } = currentCtx;
  const greet = value['greeting'] ?? '';
  const label = (t && t('fields.greeting')) || 'Greeting';
  const help =
    (t && t('help.greeting')) ||
    'Optional. Displayed in the host’s audit log when the plugin initializes. Leave blank to skip.';

  root.render(
    <div
      style={{
        display: 'flex',
        flexDirection: 'column',
        gap: '0.5rem',
        padding: '1rem',
        border: '1px solid #ccc',
        borderRadius: '0.5rem',
      }}
    >
      <label
        htmlFor="example-plugin-greeting"
        style={{ fontWeight: 600, fontSize: '0.875rem' }}
      >
        {label}
      </label>
      <input
        id="example-plugin-greeting"
        type="text"
        value={greet}
        maxLength={120}
        placeholder="Hello, world!"
        aria-describedby="example-plugin-greeting-help"
        onChange={(e) => {
          onChange({ ...value, greeting: e.target.value });
          onError?.('greeting', null);
        }}
        style={{
          padding: '0.5rem',
          border: '1px solid #ccc',
          borderRadius: '0.25rem',
          fontSize: '0.875rem',
        }}
      />
      <span
        id="example-plugin-greeting-help"
        style={{ fontSize: '0.75rem', color: '#666' }}
      >
        {help}
      </span>
    </div>,
  );
}

// mount() returns { cleanup, update } so the host can push new
// `value` snapshots back into the bundle without remounting. The
// old API (cleanup-only function) still works — the host checks
// the return shape and degrades gracefully.
export function mount(el: HTMLElement, ctx: MountCtx): {
  cleanup: () => void;
  update: (patch: Partial<MountCtx>) => void;
} {
  root = guardedRoot(el);
  currentCtx = ctx;
  render();
  return {
    cleanup: () => {
      root?.unmount();
      root = null;
      currentCtx = null;
    },
    update: (patch) => {
      if (!currentCtx) return;
      currentCtx = { ...currentCtx, ...patch };
      render();
    },
  };
}

export default { mount };
