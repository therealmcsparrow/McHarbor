// This module is intentionally separate from McHarbor's own go.mod.
// Plugins here compile against McHarbor's exported types under
// github.com/therealmcsparrow/mcharbor (host module) — `core/plugin`
// is a subpackage of the host module after the shim refactor, see
// .references/backup/2026-08-14-1900-shim-core-plugin/CHANGES.md.
// Plugins ship as standalone .tar.gz artifacts.
//
// For local development, the replace directive below points at a
// checkout of the host repo so changes to the SDK are picked up
// without a tag. Production builds use the published version of
// github.com/therealmcsparrow/mcharbor.
module github.com/therealmcsparrow/mcharbor-addons

go 1.27.2

require (
	github.com/docker/docker v28.5.2+incompatible
	github.com/go-chi/chi/v5 v5.3.2
	github.com/therealmcsparrow/mcharbor v0.0.0
	gopkg.in/yaml.v3 v3.0.1
)

require (
	filippo.io/edwards25519 v1.2.0 // indirect
	github.com/Microsoft/go-winio v0.6.2 // indirect
	github.com/caarlos0/env/v11 v11.4.1 // indirect
