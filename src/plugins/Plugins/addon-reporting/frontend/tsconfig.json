{
  "extends": "../../../../frontend/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "vite/client",
      "vitest/globals",
      "@testing-library/jest-dom/vitest"
    ],
    "typeRoots": [
      "./node_modules",
      "../../../../frontend/node_modules/@types",
      "../../../../frontend/node_modules"
