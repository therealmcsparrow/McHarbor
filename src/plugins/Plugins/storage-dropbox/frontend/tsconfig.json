{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["./src/*"],
      "@core/*": ["../../../../frontend/core/*"],
      "@resources/*": ["../../../../frontend/resources/*"],
      "@modules/*": ["../../../../frontend/modules/*"],
      "@tabler/icons-react": ["../../../../frontend/node_modules/@tabler/icons-react"],
      "@tanstack/react-query": ["../../../../frontend/node_modules/@tanstack/react-query"],
      "react": ["../../../../frontend/node_modules/@types/react"],
      "react/jsx-runtime": ["../../../../frontend/node_modules/@types/react/jsx-runtime"],
      "react-dom/*": ["../../../../frontend/node_modules/@types/react-dom/*"],
      "react-i18next": ["../../../../frontend/node_modules/react-i18next"],
      "react-router": ["../../../../frontend/node_modules/react-router/dist/production/index.d.ts"],
      "sonner": ["../../../../frontend/node_modules/sonner"],
      "zod": ["../../../../frontend/node_modules/zod"]
    }
  },
  "include": ["src"]
}
