module github.com/therealmcsparrow/mcharbor-addons/plugins/addon-swarm

go 1.27.2

// Unlike the Kubernetes add-on, nothing leaves the host binary with this
// plugin: the Docker SDK (github.com/moby/moby/client and /api, pinned to the
// host's versions) stays in the host for containers, images, volumes and
// networks, and Swarm is the same SDK talking to the same daemon. What
// moves out is the 5,600 lines of Swarm-specific code, twenty permission
// keys, sixty-nine message codes and a sidebar section — carried by an
// installation that runs a Swarm, and by no other.
require (
	github.com/containerd/errdefs v1.0.0
	github.com/go-chi/chi/v5 v5.3.2
	github.com/moby/moby/api v1.56.0
	github.com/moby/moby/client v0.6.0
	github.com/therealmcsparrow/mcharbor v0.0.0
	gopkg.in/yaml.v3 v3.0.1
)

