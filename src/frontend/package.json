{
  "name": "mcharbor-frontend",
  "version": "2026.10.02",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc -b && vp build",
    "test": "vp test run",
    "coverage": "vp test run --coverage --passWithNoTests",
    "check:a11y": "playwright test -c playwright.config.ts",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:visual:update": "playwright test -c playwright.visual.config.ts --update-snapshots",
    "preview": "vp preview",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "lint:out-of-tree": "node scripts/out-of-tree.mjs lint",
    "lint:out-of-tree:fix": "node scripts/out-of-tree.mjs lint --fix",
    "i18n:check": "node ./scripts/check-i18n.mjs",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "format:out-of-tree": "node scripts/out-of-tree.mjs fmt",
    "format:out-of-tree:check": "node scripts/out-of-tree.mjs fmt --check",
    "check": "vp check",
    "theme:tokens": "node ./scripts/theme-tokens.mjs",
    "theme:lint": "node ./scripts/theme-tokens.mjs --check && node ./scripts/theme-lint.mjs",
    "knip": "knip --include files,exports",
    "knip:report": "knip --include files,exports --no-exit-code",
    "knip:consumers": "node scripts/knip-generate-external-consumers.mjs"
  },
