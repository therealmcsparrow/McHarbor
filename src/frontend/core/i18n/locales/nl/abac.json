      "matches": "Test met reguliere expressie (RE2-syntaxis, maximaal 256 tekens).",
      "inCIDR": "Of het IP-adres in een van de netwerken valt.",
      "between": "Test op inclusief bereik.",
      "isWeekend": "Zaterdag of zondag, UTC."
    },
    "examples": {
      "prodOnly": {
        "title": "Alleen resources met een productielabel",
        "expression": "hasLabel(resource.labels, \"env\") == \"prod\""
      },
      "officeHours": {
        "title": "Alleen tijdens kantooruren",
        "expression": "!isWeekend() && between(now.hour, 8, 18)"
      },
      "internalNetwork": {
        "title": "Alleen vanaf het interne netwerk",
        "expression": "inCIDR(request.ip, \"10.0.0.0/8\", \"192.168.0.0/16\")"
      },
      "noApiKeyWrites": {
        "title": "Geen wijzigingen via API-sleutels",
        "expression": "request.apiKey && !request.readOnly"
      },
      "teamOwnership": {
        "title": "Het team van de gebruiker is eigenaar van de resource",
        "expression": "hasLabel(resource.labels, \"team\") == hasLabel(user.labels, \"team\")"
      },
      "ownResources": {
        "title": "Alleen resources waarvan de gebruiker eigenaar is",
        "expression": "resource.owner == user.id"
      },
      "largeVms": {
        "title": "Grote virtuele machines vereisen de platformgroep",
        "expression": "resource.attrs.vcpus > 8 && !inGroup(\"platform\")"
      },
      "namePattern": {
        "title": "Namen die een patroon volgen",
        "expression": "matches(resource.name, \"^web-[0-9]+$\")"
      }
    }
  }
