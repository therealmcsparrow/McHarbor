    "helpers": {
      "hasLabel": "The label's value, or an empty string when it is absent.",
      "labelIn": "Whether the label is one of the values.",
      "inList": "Whether value equals any of the items.",
      "hasRole": "Whether the user holds a role with this name.",
      "inGroup": "Whether the user is a member of this group.",
      "startsWith": "Prefix test.",
      "endsWith": "Suffix test.",
      "contains": "Substring test.",
      "matches": "Regular expression test (RE2 syntax, 256 characters at most).",
      "inCIDR": "Whether the IP lies in any of the networks.",
      "between": "Inclusive range test.",
      "isWeekend": "Saturday or Sunday, UTC."
    },
    "examples": {
      "prodOnly": {
        "title": "Only production-labelled resources",
        "expression": "hasLabel(resource.labels, \"env\") == \"prod\""
      },
      "officeHours": {
        "title": "Only during office hours",
        "expression": "!isWeekend() && between(now.hour, 8, 18)"
      },
      "internalNetwork": {
        "title": "Only from the internal network",
        "expression": "inCIDR(request.ip, \"10.0.0.0/8\", \"192.168.0.0/16\")"
      },
      "noApiKeyWrites": {
        "title": "No changes through API keys",
        "expression": "request.apiKey && !request.readOnly"
      },
      "teamOwnership": {
        "title": "The user's team owns the resource",
        "expression": "hasLabel(resource.labels, \"team\") == hasLabel(user.labels, \"team\")"
      },
      "ownResources": {
        "title": "Only resources the user owns",
        "expression": "resource.owner == user.id"
      },
      "largeVms": {
        "title": "Large virtual machines need the platform group",
        "expression": "resource.attrs.vcpus > 8 && !inGroup(\"platform\")"
      },
      "namePattern": {
        "title": "Names that follow a pattern",
        "expression": "matches(resource.name, \"^web-[0-9]+$\")"
      }
    }
  }
