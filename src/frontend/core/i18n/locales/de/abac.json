      "inList": "Ob value einem der Elemente entspricht.",
      "hasRole": "Ob der Benutzer eine Rolle mit diesem Namen besitzt.",
      "inGroup": "Ob der Benutzer Mitglied dieser Gruppe ist.",
      "startsWith": "Präfixprüfung.",
      "endsWith": "Suffixprüfung.",
      "contains": "Teilzeichenfolgenprüfung.",
      "matches": "Prüfung mit regulärem Ausdruck (RE2-Syntax, höchstens 256 Zeichen).",
      "inCIDR": "Ob die IP in einem der Netzwerke liegt.",
      "between": "Prüfung auf einen Bereich einschließlich der Grenzen.",
      "isWeekend": "Samstag oder Sonntag, UTC."
    },
    "examples": {
      "prodOnly": {
        "title": "Nur mit Produktions-Label versehene Ressourcen",
        "expression": "hasLabel(resource.labels, \"env\") == \"prod\""
      },
      "officeHours": {
        "title": "Nur während der Bürozeiten",
        "expression": "!isWeekend() && between(now.hour, 8, 18)"
      },
      "internalNetwork": {
        "title": "Nur aus dem internen Netzwerk",
        "expression": "inCIDR(request.ip, \"10.0.0.0/8\", \"192.168.0.0/16\")"
      },
      "noApiKeyWrites": {
        "title": "Keine Änderungen über API-Schlüssel",
        "expression": "request.apiKey && !request.readOnly"
      },
      "teamOwnership": {
        "title": "Das Team des Benutzers besitzt die Ressource",
        "expression": "hasLabel(resource.labels, \"team\") == hasLabel(user.labels, \"team\")"
      },
      "ownResources": {
        "title": "Nur Ressourcen, die dem Benutzer gehören",
        "expression": "resource.owner == user.id"
      },
      "largeVms": {
        "title": "Große virtuelle Maschinen erfordern die Plattformgruppe",
        "expression": "resource.attrs.vcpus > 8 && !inGroup(\"platform\")"
      },
      "namePattern": {
        "title": "Namen, die einem Muster folgen",
        "expression": "matches(resource.name, \"^web-[0-9]+$\")"
      }
    }
  }
