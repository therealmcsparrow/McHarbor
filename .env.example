# App
MCHARBOR_PORT=5173
MCHARBOR_HOST=0.0.0.0
MCHARBOR_SECRET=           # Session encryption key (auto-generated if empty)
MCHARBOR_IMAGE=ghcr.io/therealmcsparrow/mcharbor
MCHARBOR_TAG=latest

# Database
#
# Leave MCHARBOR_DB_DRIVER unset and pick the backend in the interface instead:
# Settings -> System -> Database on a running install, or the database step of
# the first-run wizard on a fresh one. The connection string is then encrypted
# with the McHarbor secret key and stored in <DATA_DIR>/database.json, so no
# credentials sit in this file or in `docker inspect` output.
#
# Setting MCHARBOR_DB_DRIVER here overrides that stored choice and makes the
# interface read-only. Use it when the database is managed by whoever writes
# this Compose file rather than by an administrator in the browser.
DATABASE_PATH=./data/MCHARBOR.db  # SQLite path (default)
#MCHARBOR_DB_DRIVER=postgres      # sqlite (default) | postgres | mysql
#MCHARBOR_DB_DSN=postgres://mcharbor:secret@postgres:5432/mcharbor?sslmode=require

# Docker
DOCKER_HOST=unix:///var/run/docker.sock  # Default Docker socket
DOCKER_TLS_VERIFY=         # Enable TLS (0 or 1)
DOCKER_CERT_PATH=          # TLS certificate directory
MCHARBOR_AGENT_IMAGE=ghcr.io/therealmcsparrow/mcharbor-agent
MCHARBOR_AGENT_TAG=latest
MCHARBOR_AGENT_DOCKER_HOST=unix:///var/run/docker.sock
MCHARBOR_AGENT_LOG_LEVEL=info
MCHARBOR_AGENT_INSECURE=false
MCHARBOR_AGENT_OFFLINE_BUFFER=true   # Buffer events, stats and agent log locally while McHarbor is unreachable
MCHARBOR_URL=              # Required only when running the optional agent profile
MCHARBOR_AGENT_TOKEN=      # Required only when running the optional agent profile

# Licensing. Keys are issued at https://www.mcharbor.eu; the McHarbor server takes
# its key through Settings -> System -> License. An agent is a seat of its own and
# claims one against the same key. Leave the key unset and the agent reports
# nothing outward.
MCHARBOR_LICENSE_KEY=
MCHARBOR_LICENSE_SERVER=https://www.mcharbor.eu

# Extra CA certificates to trust inside the container, as *.crt files. Needed when
# the licence server - or any other host McHarbor calls out to - presents a private
# or self-signed certificate: Go has no click-through for an untrusted chain the way
# a browser does, so the request simply fails. Drop the root in and the entrypoint
# folds it into the system bundle at startup. Leave the directory empty otherwise.
MCHARBOR_LOCAL_CA_PATH=./mnt/certs

# The catalog of downloadable guest images, one JSON file per entry (cloud image,
# rootfs tarball or installer ISO). Edit a file, add one, or delete one, then hit
# Reload on the Compute images page - or restart. This is the only way to change
# the built-in list: a plugin's migrations run once at install, so the SQL seed
# that ships with a fresh install can never be updated in place.
MCHARBOR_LOCAL_COMPUTE_CATALOG_PATH=./mnt/compute-catalog

# The shared compute image library. Guest images uploaded through Compute are
# written here, and every compute host bind-mounts this same directory onto its
# agent's image cache root (/var/lib/mcharbor/compute/images, a compiled-in
# constant) - so an image uploaded once is already present on each host instead
# of being transferred to it. On a remote host, point this at shared storage
# both machines can see.
MCHARBOR_COMPUTE_IMAGE_LIBRARY_PATH=./mnt/compute-images

# Encryption
ENCRYPTION_KEY=            # AES-256-GCM key (auto-generated if empty)
BACKUP_ENCRYPTION_KEY_FILE=/run/secrets/mcharbor_backup_key
MCHARBOR_BACKUP_KEY_FILE=./secrets/mcharbor_backup_key  # Used by docker-compose.secrets.yml

# Auth
AUTH_DISABLE=false          # Disable auth (dev only)

# Trusted reverse proxies, comma-separated CIDRs or bare IPs.
# Only these peers' Forwarded / X-Forwarded-For / X-Real-IP headers are
# believed when API-key usage history attributes a request to a client.
# Empty (the default) ignores those headers and records the socket peer,
# so nobody can claim an origin they do not have. Do not use 0.0.0.0/0.
# A malformed value stops the server at startup rather than being skipped.
MCHARBOR_TRUSTED_PROXY_CIDRS=

# Notifications (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
WEBHOOK_URL=
