MCHARBOR_IMAGE=ghcr.io/therealmcsparrow/mcharbor
MCHARBOR_VERSION=2026.09.01
POSTGRES_IMAGE=postgres:17-alpine

POSTGRES_PASSWORD=change-me-postgres-password
MCHARBOR_DB_DSN=

MCHARBOR_SECRET=change-me-openssl-rand-base64-48
ENCRYPTION_KEY=change-me-openssl-rand-base64-32
MCHARBOR_BACKUP_KEY_FILE=./secrets/mcharbor_backup_key
MCHARBOR_PLUGIN_STORE=

PUID=1000
PGID=1000
DOCKER_GID=999

MCHARBOR_BIND_ADDRESS=0.0.0.0
MCHARBOR_PORT=8705
MCHARBOR_NODE_ID=mcharbor-1

ALLOWED_ORIGINS=https://mcharbor.example.com
MCHARBOR_TRUSTED_PROXY_CIDRS=

TLS_ENABLED=true
TLS_MIN_VERSION=1.3
HSTS_MAX_AGE=0
FORCE_AGENT_TLS=true
SELF_SIGNED_SAN_EXTRA=

MCHARBOR_BACKUP_PATH=./backup
MCHARBOR_CA_PATH=./ca

MCHARBOR_CPUS=2
MCHARBOR_MEMORY=2g
POSTGRES_MEMORY=1g

LOG_LEVEL=info
TZ=UTC
