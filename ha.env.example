MCHARBOR_IMAGE=ghcr.io/therealmcsparrow/mcharbor:latest

POSTGRES_PASSWORD=change-me-postgres-password

MCHARBOR_SECRET_HOST_FILE=./secrets/mcharbor_secret
MCHARBOR_ENCRYPTION_KEY_HOST_FILE=./secrets/mcharbor_encryption_key
MCHARBOR_DB_DSN_HOST_FILE=./secrets/mcharbor_db_dsn

MCHARBOR_HA_MODE=active-passive
MCHARBOR_PLUGIN_STORE=database

MCHARBOR_NODE_1_ADVERTISE_URL=https://mcharbor-node-1:8705
MCHARBOR_NODE_2_ADVERTISE_URL=https://mcharbor-node-2:8705
MCHARBOR_NODE_1_HTTPS_PORT=8443
MCHARBOR_NODE_2_HTTPS_PORT=8444

ALLOWED_ORIGINS=https://mcharbor.example.com
MCHARBOR_TRUSTED_PROXY_CIDRS=
TLS_ENABLED=true
TLS_MIN_VERSION=1.3
FORCE_AGENT_TLS=true
HSTS_MAX_AGE=0
MCHARBOR_SELF_SIGNED_SAN_EXTRA=

MCHARBOR_BACKUP_KEY_FILE=./secrets/mcharbor_backup_key
MCHARBOR_SHARED_BACKUP_PATH=./mnt/backup
LOG_LEVEL=info
TZ=UTC
