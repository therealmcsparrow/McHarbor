{
    "slug":  "nzbget-testing",
    "name":  "NZBGet (Testing)",
    "description":  "Testing channel build of NZBGet. Efficient Usenet downloader with a web interface.",
    "category":  "Media",
    "image":  "lscr.io/linuxserver/nzbget:testing",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/nzbget.png",
    "website":  "https://docs.linuxserver.io/images/docker-nzbget/",
    "docsUrl":  "https://docs.linuxserver.io/images/docker-nzbget/",
    "ports":  [
                  {
                      "host":  7789,
                      "container":  6789,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/nzbget-testing/config",
                        "container":  "/config"
                    },
                    {
                        "host":  "/srv/media",
                        "container":  "/media"
                    },
                    {
                        "host":  "/srv/downloads",
                        "container":  "/downloads"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    },
                    {
                        "key":  "PUID",
                        "default":  "1000",
                        "description":  "User ID"
                    },
                    {
                        "key":  "PGID",
                        "default":  "1000",
                        "description":  "Group ID"
                    }
                ],
    "version":  "testing",
    "latest":  {
        "version":  "testing",
        "release_date":  "2026-09-29"
    }
}
