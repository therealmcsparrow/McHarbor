{
    "slug":  "dex",
    "name":  "Dex",
    "description":  "OpenID Connect identity provider that federates authentication to LDAP, SAML, and other upstream login systems.",
    "category":  "Identity & SSO",
    "image":  "dexidp/dex:latest",
    "logo":  "https://www.google.com/s2/favicons?domain=dexidp.io\u0026sz=128",
    "website":  "https://dexidp.io",
    "docsUrl":  "https://dexidp.io/docs/getting-started/",
    "ports":  [
                  {
                      "host":  5556,
                      "container":  5556,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/dex/config",
                        "container":  "/etc/dex/cfg"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
