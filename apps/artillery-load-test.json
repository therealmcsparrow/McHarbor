{
    "slug":  "artillery-load-test",
    "name":  "Artillery Load Test",
    "description":  "Modern, powerful load testing toolkit for APIs and microservices.",
    "category":  "Developer Tools",
    "image":  "artilleryio/artillery:latest",
    "logo":  "https://icon.horse/icon/www.artillery.io",
    "website":  "https://www.artillery.io",
    "docsUrl":  "https://www.artillery.io/docs/guides/getting-started/installing-artillery",
    "ports":  [
                  {
                      "host":  80,
                      "container":  80,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/artillery-load-test/config",
                        "container":  "/config"
                    },
                    {
                        "host":  "/opt/appdata/artillery-load-test/reports",
                        "container":  "/reports"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "version":  "latest"
}
