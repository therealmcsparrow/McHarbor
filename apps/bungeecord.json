{
    "slug":  "bungeecord",
    "name":  "BungeeCord",
    "description":  "Proxy server that lets players move between multiple backend Minecraft servers.",
    "category":  "Gaming",
    "image":  "itzg/bungeecord:latest",
    "logo":  "https://www.google.com/s2/favicons?domain=www.spigotmc.org\u0026sz=128",
    "website":  "https://www.spigotmc.org/wiki/bungeecord/",
    "docsUrl":  "https://github.com/itzg/docker-bungeecord",
    "ports":  [
                  {
                      "host":  25577,
                      "container":  25577,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/bungeecord/data",
                        "container":  "/server"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    },
                    {
                        "key":  "TYPE",
                        "default":  "WATERFALL",
                        "description":  "Proxy flavor to run (BUNGEECORD or WATERFALL)"
                    },
                    {
                        "key":  "MEMORY",
                        "default":  "512M",
                        "description":  "JVM memory allocation"
                    }
                ],
    "minMemory":  "1GB",
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
