{
    "slug":  "solr",
    "name":  "Apache Solr",
    "description":  "Apache Solr 9 open-source enterprise search platform built on Apache Lucene.",
    "category":  "Databases",
    "image":  "solr:9",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/apache-solr.svg",
    "website":  "https://solr.apache.org",
    "docsUrl":  "https://solr.apache.org/guide/",
    "ports":  [
                  {
                      "host":  8983,
                      "container":  8983,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/solr/data",
                        "container":  "/var/solr"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone for container logs and scheduled tasks"
                    }
                ],
    "version":  "9",
    "latest":  {
        "version":  "9",
        "release_date":  "2026-09-10"
    }
}
