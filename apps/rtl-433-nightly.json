{
    "slug":  "rtl-433-nightly",
    "name":  "rtl_433 (Nightly)",
    "description":  "Nightly channel build of rtl_433. Decode 433 MHz and other ISM-band sensors, weather stations, and meters, then publish readings to MQTT.",
    "category":  "Home Automation",
    "image":  "hertzg/rtl_433:nightly",
    "logo":  "https://github.githubassets.com/favicons/favicon.svg",
    "website":  "https://github.com/merbanan/rtl_433",
    "docsUrl":  "https://github.com/hertzg/rtl_433_docker#readme",
    "ports":  [

              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/rtl-433",
                        "container":  "/etc/rtl_433"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    },
                    {
                        "key":  "RTL_DEVICE",
                        "default":  "/dev/bus/usb:/dev/bus/usb",
                        "description":  "SDR device mapping for Docker Compose devices"
                    },
                    {
                        "key":  "RTL_433_COMMAND",
                        "default":  "-F mqtt://mosquitto:1883,retain=0,devices=rtl_433[/model][/id]",
                        "description":  "rtl_433 command arguments"
                    }
                ],
    "version":  "nightly",
    "latest":  {
        "version":  "nightly",
        "release_date":  "2026-09-29"
    },
    "composeOverride":  "# Generated by McHarbor App Store\nservices:\n  {{serviceName}}:\n    image: {{image}}\n    container_name: {{containerName}}\n    restart: unless-stopped\n{{volumes}}\n    devices:\n      - {{env.RTL_DEVICE}}\n    command: {{env.RTL_433_COMMAND}}\n"
}
