{
    "slug":  "redis-insight",
    "name":  "Redis Insight",
    "description":  "Official GUI for browsing, querying and monitoring Redis and Redis-compatible databases.",
    "category":  "Developer Tools",
    "image":  "redis/redisinsight:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/redis.png",
    "website":  "https://redis.io/insight/",
    "docsUrl":  "https://redis.io/docs/latest/operate/redisinsight/install/",
    "ports":  [
                  {
                      "host":  5540,
                      "container":  5540,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/redis-insight/data",
                        "container":  "/data"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
