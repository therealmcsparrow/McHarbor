{
    "slug":  "openproject",
    "name":  "OpenProject",
    "description":  "Open source project management platform for planning, task tracking, and team collaboration.",
    "category":  "Productivity",
    "image":  "openproject/openproject:15",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/openproject.png",
    "website":  "https://www.openproject.org",
    "docsUrl":  "https://www.openproject.org/docs/installation-and-operations/installation/docker/",
    "ports":  [
                  {
                      "host":  8100,
                      "container":  80,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/openproject/pgdata",
                        "container":  "/var/openproject/pgdata"
                    },
                    {
                        "host":  "/opt/appdata/openproject/assets",
                        "container":  "/var/openproject/assets"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    },
                    {
                        "key":  "SECRET_KEY_BASE",
                        "default":  "change-me",
                        "description":  "Application secret key",
                        "secret":  true
                    },
                    {
                        "key":  "OPENPROJECT_HOST__NAME",
                        "default":  "localhost:8100",
                        "description":  "Public hostname"
                    }
                ],
    "minMemory":  "2GB",
    "version":  "15",
    "latest":  {
        "version":  "15",
        "release_date":  "2026-09-29"
    }
}
