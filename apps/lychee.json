{
    "slug":  "lychee",
    "name":  "Lychee",
    "description":  "Self-hosted photo-management system with a clean responsive interface.",
    "category":  "Photos \u0026 Files",
    "image":  "lycheeorg/lychee:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/lychee.png",
    "website":  "https://lycheeorg.github.io",
    "docsUrl":  "https://lycheeorg.github.io/docs/",
    "ports":  [
                  {
                      "host":  80,
                      "container":  80,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/lychee/config",
                        "container":  "/conf"
                    },
                    {
                        "host":  "/opt/appdata/lychee/uploads",
                        "container":  "/uploads"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "version":  "latest"
}
