{
    "slug":  "percona-pmm",
    "name":  "Percona Monitoring and Management",
    "description":  "Database observability platform for monitoring MySQL, PostgreSQL, and MongoDB performance and queries.",
    "category":  "Monitoring",
    "image":  "percona/pmm-server:2",
    "logo":  "https://github.com/percona.png",
    "website":  "https://www.percona.com/software/database-tools/percona-monitoring-and-management",
    "docsUrl":  "https://docs.percona.com/percona-monitoring-and-management/setting-up/server/docker.html",
    "ports":  [
                  {
                      "host":  8102,
                      "container":  443,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/percona-pmm/data",
                        "container":  "/srv"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    },
                    {
                        "key":  "PMM_ADMIN_PASSWORD",
                        "default":  "change-me",
                        "description":  "Initial password for the PMM Server admin user",
                        "secret":  true
                    }
                ],
    "minMemory":  "2GB",
    "version":  "2",
    "latest":  {
        "version":  "2",
        "release_date":  "2026-09-29"
    }
}
