{
    "slug":  "bazel-remote-cache",
    "name":  "Bazel Remote Cache",
    "description":  "HTTP and gRPC remote build cache server for Bazel, Buck2, Goma, and other build tools.",
    "category":  "Storage",
    "image":  "buchgr/bazel-remote-cache:latest",
    "logo":  "https://cdn.simpleicons.org/bazel",
    "website":  "https://github.com/buchgr/bazel-remote",
    "docsUrl":  "https://github.com/buchgr/bazel-remote#docker-image",
    "ports":  [
                  {
                      "host":  8180,
                      "container":  8080,
                      "protocol":  "tcp"
                  },
                  {
                      "host":  9130,
                      "container":  9092,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/bazel-remote-cache/data",
                        "container":  "/data"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "minMemory":  "512MB",
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    },
    "composeOverride":  "# Generated by McHarbor App Store\nservices:\n  {{serviceName}}:\n    image: {{image}}\n    container_name: {{containerName}}\n    restart: unless-stopped\n{{ports}}\n    command: \"--max_size=10 --dir=/data --http_address=0.0.0.0:8080 --grpc_address=0.0.0.0:9092\"\n    environment:\n      TZ: {{env.TZ}}\n    volumes:\n      - {{appDataPath}}/data:/data\n"
}
