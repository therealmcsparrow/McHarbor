{
    "slug":  "uptime-kuma-nightly",
    "name":  "Uptime Kuma (Nightly)",
    "description":  "Nightly channel build of Uptime Kuma. Self-hosted monitoring tool with a fancy UI. Monitor HTTP, TCP, DNS, and more.",
    "category":  "Monitoring",
    "image":  "louislam/uptime-kuma:nightly",
    "logo":  "https://uptime.kuma.pet/img/icon.svg",
    "website":  "https://uptime.kuma.pet",
    "docsUrl":  "https://github.com/louislam/uptime-kuma/wiki",
    "ports":  [
                  {
                      "host":  4001,
                      "container":  3001,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/uptime-kuma-nightly/data",
                        "container":  "/app/data"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "version":  "nightly",
    "latest":  {
        "version":  "nightly",
        "release_date":  "2026-09-29"
    }
}
