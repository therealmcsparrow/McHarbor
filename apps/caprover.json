{
    "slug":  "caprover",
    "name":  "CapRover",
    "description":  "Self-hosted PaaS that deploys apps and databases from simple templates on top of Docker Swarm.",
    "category":  "CI/CD",
    "image":  "caprover/caprover:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/caprover.png",
    "website":  "https://caprover.com",
    "docsUrl":  "https://caprover.com/docs/get-started.html",
    "ports":  [
                  {
                      "host":  3050,
                      "container":  3000,
                      "protocol":  "tcp"
                  },
                  {
                      "host":  8081,
                      "container":  80,
                      "protocol":  "tcp"
                  },
                  {
                      "host":  4431,
                      "container":  443,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/caprover/data",
                        "container":  "/captain"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "minMemory":  "1GB",
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
