{
  "slug": "akaunting",
  "name": "Akaunting",
  "description": "Free online accounting software for invoicing, expenses, and small business finances.",
  "category": "Productivity",
  "image": "akaunting/akaunting:latest",
  "logo": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/akaunting.png",
  "website": "https://akaunting.com",
  "docsUrl": "https://akaunting.com/docs",
  "ports": [
    {
      "host": 8597,
      "container": 80,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "host": "/opt/appdata/akaunting/data",
      "container": "/var/www/html/data"
    },
    {
      "host": "/opt/appdata/akaunting/storage",
      "container": "/var/www/html/storage"
    }
  ],
  "envVars": [
    {
      "key": "TZ",
      "default": "Etc/UTC",
      "description": "Timezone"
    },
    {
      "key": "DB_HOST",
      "default": "mariadb",
      "description": "Database host"
    },
    {
      "key": "DB_DATABASE",
      "default": "akaunting",
      "description": "Database name"
    },
    {
      "key": "DB_USERNAME",
      "default": "akaunting",
      "description": "Database user"
    },
    {
      "key": "DB_PASSWORD",
      "default": "",
      "description": "Database password",
      "secret": true
    },
    {
      "key": "APP_KEY",
      "default": "",
      "description": "Application encryption key",
      "secret": true
    }
  ],
  "version": "latest"
}
