{
    "slug":  "autobrr",
    "name":  "autobrr",
    "description":  "Automation for racing torrents from IRC announce channels.",
    "category":  "Media",
    "image":  "ghcr.io/autobrr/autobrr:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/autobrr.png",
    "website":  "https://autobrr.com",
    "docsUrl":  "https://autobrr.com",
    "ports":  [
                  {
                      "host":  7474,
                      "container":  7474,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/autobrr/config",
                        "container":  "/config"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "version":  "latest"
}
