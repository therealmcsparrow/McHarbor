{
    "slug":  "homarr-dev",
    "name":  "Homarr (Dev)",
    "description":  "Dev channel build of Homarr. Customizable dashboard for your server with service integrations.",
    "category":  "Utilities",
    "image":  "ghcr.io/ajnart/homarr:dev",
    "logo":  "https://homarr.dev/img/logo.png",
    "website":  "https://homarr.dev",
    "docsUrl":  "https://homarr.dev/docs/getting-started/",
    "ports":  [
                  {
                      "host":  8575,
                      "container":  7575,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/homarr-dev/configs",
                        "container":  "/app/data/configs"
                    },
                    {
                        "host":  "/opt/appdata/homarr-dev/icons",
                        "container":  "/app/public/icons"
                    },
                    {
                        "host":  "/var/run/docker.sock",
                        "container":  "/var/run/docker.sock",
                        "readOnly":  true
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "version":  "dev",
    "latest":  {
        "version":  "dev",
        "release_date":  "2026-09-29"
    }
}
