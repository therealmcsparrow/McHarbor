{
    "slug":  "tasmoadmin-beta",
    "name":  "TasmoAdmin (Beta)",
    "description":  "Beta channel build of TasmoAdmin. Web admin interface to manage multiple Tasmota devices from one place.",
    "category":  "Home Automation",
    "image":  "ghcr.io/tasmoadmin/tasmoadmin:beta",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/tasmoadmin.png",
    "website":  "https://github.com/tasmoadmin/TasmoAdmin",
    "docsUrl":  "https://github.com/tasmoadmin/TasmoAdmin",
    "ports":  [
                  {
                      "host":  1080,
                      "container":  80,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/tasmoadmin-beta/data",
                        "container":  "/data"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "version":  "beta",
    "latest":  {
        "version":  "beta",
        "release_date":  "2026-09-29"
    }
}
