{
    "slug":  "greptimedb",
    "name":  "GreptimeDB",
    "description":  "Cloud-native time-series database that unifies metrics, logs and events with SQL and PromQL support.",
    "category":  "Analytics",
    "image":  "greptime/greptimedb:latest",
    "logo":  "https://github.com/GreptimeTeam.png",
    "website":  "https://greptime.com",
    "docsUrl":  "https://docs.greptime.com/getting-started/installation/greptimedb-standalone/",
    "ports":  [
                  {
                      "host":  4000,
                      "container":  4000,
                      "protocol":  "tcp"
                  },
                  {
                      "host":  4002,
                      "container":  4002,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/greptimedb/data",
                        "container":  "/greptimedb_data"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "minMemory":  "1GB",
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
