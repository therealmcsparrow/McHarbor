{
    "slug":  "minio",
    "name":  "MinIO",
    "description":  "S3-compatible object storage for backups and homelab data.",
    "category":  "Photos \u0026 Files",
    "image":  "quay.io/minio/minio:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/minio.png",
    "website":  "https://min.io",
    "docsUrl":  "https://min.io/docs",
    "ports":  [
                  {
                      "host":  9000,
                      "container":  9000,
                      "protocol":  "tcp"
                  },
                  {
                      "host":  9001,
                      "container":  9001,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/minio/data",
                        "container":  "/data"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "MINIO_ROOT_USER",
                        "default":  "minioadmin",
                        "description":  "Root access key"
                    },
                    {
                        "key":  "MINIO_ROOT_PASSWORD",
                        "default":  "minioadmin",
                        "description":  "Root secret key",
                        "secret":  true
                    }
                ],
    "version":  "latest",
    "composeOverride":  "# Generated by McHarbor App Store\nservices:\n  {{serviceName}}:\n    image: {{image}}\n    container_name: {{containerName}}\n    restart: unless-stopped\n{{ports}}\n    environment:\n      MINIO_ROOT_USER: {{env.MINIO_ROOT_USER}}\n      MINIO_ROOT_PASSWORD: {{env.MINIO_ROOT_PASSWORD}}\n    volumes:\n      - {{appDataPath}}/data:/data\n    command: server /data --console-address \":9001\"\n"
}
