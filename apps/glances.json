{
    "slug":  "glances",
    "name":  "Glances",
    "description":  "Cross-platform real-time system monitor with web UI, API and exporter modes.",
    "category":  "Monitoring",
    "image":  "nicolargo/glances:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/glances.png",
    "website":  "https://nicolargo.github.io/glances",
    "docsUrl":  "https://github.com/nicolargo/glances/blob/master/docs/docker.md",
    "ports":  [
                  {
                      "host":  61208,
                      "container":  61208,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/glances/config",
                        "container":  "/glances/conf"
                    },
                    {
                        "host":  "/var/run/docker.sock",
                        "container":  "/var/run/docker.sock"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    },
                    {
                        "key":  "GLANCES_OPT",
                        "default":  "-w",
                        "description":  "Glances options (-w web UI, -s server, -t refresh)"
                    }
                ],
    "version":  "latest"
}
