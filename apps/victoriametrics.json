{
  "slug": "victoriametrics",
  "name": "VictoriaMetrics",
  "description": "Fast time-series database and Prometheus-compatible metrics backend.",
  "category": "Monitoring",
  "image": "victoriametrics/victoria-metrics:latest",
  "logo": "",
  "website": "https://victoriametrics.com",
  "docsUrl": "https://docs.victoriametrics.com",
  "ports": [
    {
      "host": 8428,
      "container": 8428,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "host": "/opt/appdata/victoriametrics/data",
      "container": "/victoria-metrics-data"
    }
  ],
  "envVars": [
    {
      "key": "TZ",
      "default": "Etc/UTC",
      "description": "Timezone"
    }
  ],
  "version": "latest"
}
