{
    "slug":  "dendrite",
    "name":  "Dendrite",
    "description":  "Second-generation Matrix homeserver written in Go, lighter weight than Synapse.",
    "category":  "Communications",
    "image":  "matrixdotorg/dendrite-monolith:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/matrix.png",
    "website":  "https://matrix.org/docs/projects/server/dendrite",
    "docsUrl":  "https://element-hq.github.io/dendrite/installation/docker/",
    "ports":  [
                  {
                      "host":  8030,
                      "container":  8008,
                      "protocol":  "tcp"
                  },
                  {
                      "host":  8031,
                      "container":  8448,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/dendrite/data",
                        "container":  "/etc/dendrite"
                    },
                    {
                        "host":  "/opt/appdata/dendrite/media",
                        "container":  "/var/dendrite/media"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    },
                    {
                        "key":  "DENDRITE_SERVER_NAME",
                        "default":  "matrix.example.com",
                        "description":  "Matrix server name clients federate against"
                    }
                ],
    "minMemory":  "512MB",
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
