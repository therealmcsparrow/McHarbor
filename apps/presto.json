{
    "slug":  "presto",
    "name":  "Presto",
    "description":  "Distributed SQL query engine for big data, originally created at Facebook and now maintained by the Presto Foundation.",
    "category":  "Analytics",
    "image":  "prestodb/presto:latest",
    "logo":  "https://github.com/prestodb.png",
    "website":  "https://prestodb.io",
    "docsUrl":  "https://prestodb.io/docs/current/installation/deployment.html",
    "ports":  [
                  {
                      "host":  8086,
                      "container":  8080,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/presto/etc",
                        "container":  "/opt/presto-server/etc"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "minMemory":  "2GB",
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
