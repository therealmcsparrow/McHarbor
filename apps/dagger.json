{
    "slug":  "dagger",
    "name":  "Dagger",
    "description":  "Programmable CI/CD engine that runs pipelines as code in containers, driven by the Dagger CLI or SDKs.",
    "category":  "Developer Tools",
    "image":  "registry.dagger.io/engine:latest",
    "logo":  "https://www.google.com/s2/favicons?domain=dagger.io\u0026sz=128",
    "website":  "https://dagger.io",
    "docsUrl":  "https://docs.dagger.io/install",
    "ports":  [

              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/dagger/cache",
                        "container":  "/var/lib/dagger"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "minMemory":  "1GB",
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
