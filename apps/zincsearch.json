{
    "slug":  "zincsearch",
    "name":  "ZincSearch",
    "description":  "Lightweight full-text search engine that is a simpler alternative to Elasticsearch.",
    "category":  "Databases",
    "image":  "public.ecr.aws/zinclabs/zincsearch:latest",
    "logo":  "https://cdn.simpleicons.org/zincsearch",
    "website":  "https://zincsearch.com",
    "docsUrl":  "https://docs.zincsearch.com/quickstart/",
    "ports":  [
                  {
                      "host":  4080,
                      "container":  4080,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/zincsearch/data",
                        "container":  "/data"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    },
                    {
                        "key":  "ZINC_FIRST_ADMIN_USER",
                        "default":  "admin",
                        "description":  "Initial admin username"
                    },
                    {
                        "key":  "ZINC_FIRST_ADMIN_PASSWORD",
                        "default":  "change-me",
                        "description":  "Initial admin password",
                        "secret":  true
                    }
                ],
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
