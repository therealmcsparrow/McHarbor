{
    "slug":  "podfetch",
    "name":  "Podfetch",
    "description":  "Self-hosted podcast server that downloads, organizes and serves subscribed shows.",
    "category":  "Media",
    "image":  "samuel19982/podfetch:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/podfetch.png",
    "website":  "https://podfetch.de",
    "docsUrl":  "https://github.com/samuel19982/podfetch#docker",
    "ports":  [
                  {
                      "host":  4053,
                      "container":  80,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/podfetch/podcasts",
                        "container":  "/app/podcasts"
                    },
                    {
                        "host":  "/opt/appdata/podfetch/db",
                        "container":  "/app/db"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    },
                    {
                        "key":  "PASSWORD",
                        "default":  "change-me",
                        "description":  "Initial admin account password",
                        "secret":  true
                    }
                ],
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
