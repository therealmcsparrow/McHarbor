{
    "slug":  "swagger-ui",
    "name":  "Swagger UI",
    "description":  "Interactive documentation for OpenAPI specifications served in the browser.",
    "category":  "Developer Tools",
    "image":  "swaggerapi/swagger-ui:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/swagger.svg",
    "website":  "https://swagger.io",
    "docsUrl":  "https://swagger.io/docs/specification/about/",
    "ports":  [
                  {
                      "host":  8080,
                      "container":  8080,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [

                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    },
                    {
                        "key":  "SWAGGER_JSON",
                        "default":  "/api/openapi.json",
                        "description":  "Path or URL to the OpenAPI spec"
                    },
                    {
                        "key":  "BASE_URL",
                        "default":  "/swagger",
                        "description":  "Base URL under which Swagger UI is served"
                    }
                ],
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-10"
    }
}
