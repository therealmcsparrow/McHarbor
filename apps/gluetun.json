{
  "slug": "gluetun",
  "name": "Gluetun",
  "description": "VPN client container for dozens of providers that other containers can route their traffic through.",
  "category": "Networking",
  "image": "qmcgaw/gluetun:latest",
  "logo": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/gluetun.png",
  "website": "https://github.com/qdm12/gluetun",
  "docsUrl": "https://github.com/qdm12/gluetun-wiki",
  "ports": [
    {
      "host": 8888,
      "container": 8888,
      "protocol": "tcp"
    },
    {
      "host": 8388,
      "container": 8388,
      "protocol": "tcp"
    },
    {
      "host": 8388,
      "container": 8388,
      "protocol": "udp"
    },
    {
      "host": 8008,
      "container": 8000,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "host": "/opt/appdata/gluetun/data",
      "container": "/gluetun"
    }
  ],
  "envVars": [
    {
      "key": "VPN_SERVICE_PROVIDER",
      "default": "mullvad",
      "description": "VPN provider name, see the Gluetun wiki"
    },
    {
      "key": "VPN_TYPE",
      "default": "wireguard",
      "description": "wireguard or openvpn"
    },
    {
      "key": "WIREGUARD_PRIVATE_KEY",
      "default": "",
      "description": "WireGuard private key from your provider",
      "secret": true
    },
    {
      "key": "WIREGUARD_ADDRESSES",
      "default": "",
      "description": "WireGuard interface address, e.g. 10.64.222.21/32"
    },
    {
      "key": "OPENVPN_USER",
      "default": "",
      "description": "OpenVPN username (openvpn only)"
    },
    {
      "key": "OPENVPN_PASSWORD",
      "default": "",
      "description": "OpenVPN password (openvpn only)",
      "secret": true
    },
    {
      "key": "SERVER_COUNTRIES",
      "default": "Netherlands",
      "description": "Comma-separated server countries"
    },
    {
      "key": "HTTPPROXY",
      "default": "on",
      "description": "Enable the HTTP proxy on port 8888"
    },
    {
      "key": "TZ",
      "default": "Etc/UTC",
      "description": "Timezone for logs and scheduled tasks"
    }
  ],
  "composeOverride": "# Generated by McHarbor App Store\nservices:\n  {{serviceName}}:\n    image: {{image}}\n    container_name: {{containerName}}\n    restart: unless-stopped\n    cap_add:\n      - NET_ADMIN\n    devices:\n      - /dev/net/tun:/dev/net/tun\n{{ports}}\n{{volumes}}\n{{environment}}\n",
  "version": "latest",
  "latest": {
    "version": "latest",
    "release_date": "2026-09-27"
  }
}
