{
    "slug":  "ory-keto",
    "name":  "Ory Keto",
    "description":  "Open-source authorization server implementing Google Zanzibar-style relationship-based access control.",
    "category":  "Identity & SSO",
    "image":  "oryd/keto:latest",
    "logo":  "https://cdn.simpleicons.org/ory",
    "website":  "https://www.ory.sh/keto",
    "docsUrl":  "https://www.ory.sh/docs/keto/install",
    "ports":  [
                  {
                      "host":  4466,
                      "container":  4466,
                      "protocol":  "tcp"
                  },
                  {
                      "host":  4467,
                      "container":  4467,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/ory-keto/config",
                        "container":  "/home/ory"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    },
                    {
                        "key":  "DSN",
                        "default":  "sqlite:///home/ory/db.sqlite?_fk=true",
                        "description":  "Database connection string for the permission store"
                    }
                ],
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
