{
    "slug":  "zigbee2mqtt-dev",
    "name":  "Zigbee2MQTT (Dev)",
    "description":  "Dev channel build of Zigbee2MQTT. Bridge Zigbee devices to MQTT without a vendor bridge or gateway.",
    "category":  "Home Automation",
    "image":  "koenkk/zigbee2mqtt:latest-dev",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/zigbee2mqtt.png",
    "website":  "https://www.zigbee2mqtt.io",
    "docsUrl":  "https://www.zigbee2mqtt.io/guide/getting-started/",
    "ports":  [
                  {
                      "host":  9485,
                      "container":  8080,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/zigbee2mqtt-dev/data",
                        "container":  "/app/data"
                    },
                    {
                        "host":  "/run/udev",
                        "container":  "/run/udev",
                        "readOnly":  true
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "version":  "latest-dev",
    "latest":  {
        "version":  "latest-dev",
        "release_date":  "2026-09-29"
    }
}
