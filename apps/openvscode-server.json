{
    "slug":  "openvscode-server",
    "name":  "OpenVSCode Server",
    "description":  "Browser-based VS Code editor for remote development, maintained by Gitpod without a login wall.",
    "category":  "Developer Tools",
    "image":  "gitpod/openvscode-server:latest",
    "logo":  "https://www.google.com/s2/favicons?domain=github.com\u0026sz=128",
    "website":  "https://github.com/gitpod-io/openvscode-server",
    "docsUrl":  "https://github.com/gitpod-io/openvscode-server#how-to-use-it",
    "ports":  [
                  {
                      "host":  3000,
                      "container":  3000,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/openvscode-server/workspace",
                        "container":  "/home/workspace"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    },
                    {
                        "key":  "CONNECTION_TOKEN",
                        "default":  "change-me",
                        "description":  "Access token required to connect to the editor",
                        "secret":  true
                    }
                ],
    "minMemory":  "512MB",
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
