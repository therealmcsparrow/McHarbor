{
    "slug":  "hyperdx",
    "name":  "HyperDX",
    "description":  "All-in-one open-source observability platform for logs, traces, metrics, and session replay.",
    "category":  "Monitoring",
    "image":  "hyperdx/hyperdx-all-in-one:latest",
    "logo":  "https://github.com/hyperdxio.png",
    "website":  "https://www.hyperdx.io",
    "docsUrl":  "https://www.hyperdx.io/docs/install/docker-compose",
    "ports":  [
                  {
                      "host":  8087,
                      "container":  8080,
                      "protocol":  "tcp"
                  },
                  {
                      "host":  4321,
                      "container":  4317,
                      "protocol":  "tcp"
                  },
                  {
                      "host":  4322,
                      "container":  4318,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/hyperdx/data",
                        "container":  "/data/db"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "minMemory":  "2GB",
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
