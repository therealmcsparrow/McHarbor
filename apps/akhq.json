{
    "slug":  "akhq",
    "name":  "AKHQ",
    "description":  "Web UI for browsing Kafka topics, consumer groups, schemas, and Kafka Connect.",
    "category":  "Message Queues",
    "image":  "tchiotludo/akhq:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/akhq.png",
    "website":  "https://akhq.io",
    "docsUrl":  "https://akhq.io/docs/",
    "ports":  [
                  {
                      "host":  9080,
                      "container":  8080,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/akhq/config",
                        "container":  "/app/config"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "minMemory":  "512MB",
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
