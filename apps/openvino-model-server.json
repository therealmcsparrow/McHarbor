{
    "slug":  "openvino-model-server",
    "name":  "OpenVINO Model Server",
    "description":  "Scalable inference server for deploying OpenVINO and ONNX models behind a REST and gRPC API on Intel hardware.",
    "category":  "Developer Tools",
    "image":  "openvino/model_server:latest",
    "logo":  "https://www.google.com/s2/favicons?domain=github.com\u0026sz=128",
    "website":  "https://github.com/openvinotoolkit/model_server",
    "docsUrl":  "https://docs.openvino.ai/latest/ovms_docs_docker_container.html",
    "ports":  [
                  {
                      "host":  9000,
                      "container":  9000,
                      "protocol":  "tcp"
                  },
                  {
                      "host":  8000,
                      "container":  8000,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/openvino-model-server/models",
                        "container":  "/models"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "minMemory":  "2GB",
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    },
    "composeOverride":  "# Generated by McHarbor App Store\nservices:\n  {{serviceName}}:\n    image: {{image}}\n    container_name: {{containerName}}\n    restart: unless-stopped\n{{ports}}\n    command: \"--model_path /models --model_name model --port 9000 --rest_port 8000\"\n    environment:\n      TZ: {{env.TZ}}\n    volumes:\n      - {{appDataPath}}/models:/models\n"
}
