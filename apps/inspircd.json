{
    "slug":  "inspircd",
    "name":  "InspIRCd",
    "description":  "Modular, high-performance IRC server used to run public and private IRC networks.",
    "category":  "Communications",
    "image":  "inspircd/inspircd-docker:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/selfhst/icons/svg/inspircd.svg",
    "website":  "https://www.inspircd.org",
    "docsUrl":  "https://docs.inspircd.org/4/installation/docker/",
    "ports":  [
                  {
                      "host":  6667,
                      "container":  6667,
                      "protocol":  "tcp"
                  },
                  {
                      "host":  6697,
                      "container":  6697,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/inspircd/conf",
                        "container":  "/inspircd/conf"
                    },
                    {
                        "host":  "/opt/appdata/inspircd/data",
                        "container":  "/inspircd/data"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "minMemory":  "128MB",
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
