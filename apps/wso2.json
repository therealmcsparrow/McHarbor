{
    "slug":  "wso2",
    "name":  "WSO2 Identity Server",
    "description":  "Enterprise identity and access management with OAuth2, OIDC, and SAML.",
    "category":  "Security",
    "image":  "wso2/wso2is:latest",
    "logo":  "https://icon.horse/icon/wso2.com",
    "website":  "https://wso2.com/identity-server",
    "docsUrl":  "https://is.docs.wso2.com",
    "ports":  [
                  {
                      "host":  9443,
                      "container":  9443,
                      "protocol":  "tcp"
                  },
                  {
                      "host":  9763,
                      "container":  9763,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/wso2/repository",
                        "container":  "/home/wso2carbon/wso2is-7.0.0/repository"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    },
                    {
                        "key":  "JAVA_OPTS",
                        "default":  "-Xms512m -Xmx1024m",
                        "description":  "JVM options"
                    }
                ],
    "minMemory":  "2GB",
    "version":  "latest"
}
