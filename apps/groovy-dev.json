{
    "slug":  "groovy-dev",
    "name":  "Groovy",
    "description":  "Apache Groovy, dynamic language for the JVM with scripting and domain-specific language support.",
    "category":  "Developer Tools",
    "image":  "groovy:latest",
    "logo":  "https://www.google.com/s2/favicons?domain=groovy-lang.org\u0026sz=128",
