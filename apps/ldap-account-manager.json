{
    "slug":  "ldap-account-manager",
    "name":  "LDAP Account Manager",
    "description":  "Web front end for administering users, groups, and other objects stored in an LDAP directory.",
    "category":  "Identity & SSO",
    "image":  "ldapaccountmanager/lam:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/ldap-account-manager.png",
    "website":  "https://www.ldap-account-manager.org",
    "docsUrl":  "https://www.ldap-account-manager.org/lamcms/documentation",
    "ports":  [
                  {
                      "host":  8085,
                      "container":  80,
                      "protocol":  "tcp"
                  },
                  {
                      "host":  8446,
                      "container":  443,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/ldap-account-manager/config",
                        "container":  "/var/www/html/config"
                    },
                    {
                        "host":  "/opt/appdata/ldap-account-manager/sess",
                        "container":  "/var/www/html/sess"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    },
                    {
                        "key":  "LAM_PASSWORD",
                        "default":  "change-me",
                        "description":  "Master password used to encrypt LAM configuration",
                        "secret":  true
                    },
                    {
                        "key":  "LDAP_SERVER",
                        "default":  "ldap://openldap:389",
                        "description":  "URI of the LDAP server to manage"
                    }
                ],
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
