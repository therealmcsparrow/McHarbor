{
    "slug":  "ergo",
    "name":  "Ergo",
    "description":  "Modern IRC server written in Go with built-in account registration, history and bouncer support.",
    "category":  "Communications",
    "image":  "ergochat/ergo:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/selfhst/icons/svg/ergo.svg",
    "website":  "https://ergo.chat",
    "docsUrl":  "https://github.com/ergochat/ergo/blob/master/docker/README.md",
    "ports":  [
                  {
                      "host":  6667,
                      "container":  6667,
                      "protocol":  "tcp"
                  },
                  {
                      "host":  6697,
                      "container":  6697,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/ergo/config",
                        "container":  "/ircd/conf"
                    },
                    {
                        "host":  "/opt/appdata/ergo/data",
                        "container":  "/ircd/data"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "minMemory":  "128MB",
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
