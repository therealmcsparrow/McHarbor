{
    "slug":  "gitness",
    "name":  "Gitness",
    "description":  "Open-source code hosting, review, and CI platform from Harness.",
    "category":  "Developer Tools",
    "image":  "harness/gitness:latest",
    "logo":  "https://icon.horse/icon/www.harness.io",
    "website":  "https://www.harness.io/products/gitness",
    "docsUrl":  "https://docs.gitness.com",
    "ports":  [
                  {
                      "host":  3000,
                      "container":  3000,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/gitness/data",
                        "container":  "/data"
                    },
                    {
                        "host":  "/opt/appdata/gitness/config",
                        "container":  "/harness"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "version":  "latest"
}
