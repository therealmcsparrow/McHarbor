{
    "slug":  "otbr-tcp",
    "name":  "OpenThread Border Router (network radio)",
    "description":  "OpenThread Border Router for a network-attached Thread radio such as the SMLIGHT SLZB-06M, reached over TCP, for Home Assistant Thread and Matter.",
    "category":  "Home Automation",
    "image":  "bnutzer/otbr-tcp:latest",
    "logo":  "https://openthread.io/images/ot-contrib-google.png",
    "website":  "https://github.com/bnutzer/docker-otbr-tcp",
    "docsUrl":  "https://github.com/bnutzer/docker-otbr-tcp#configuration",
    "ports":  [

              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/otbr-tcp/data",
                        "container":  "/var/lib/thread"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    },
                    {
                        "key":  "RCP_HOST",
                        "default":  "SLZB-06M.local",
                        "description":  "Hostname or IP address of the network Thread radio (required)"
                    },
                    {
                        "key":  "RCP_PORT",
                        "default":  "6638",
                        "description":  "TCP port of the radio; 6638 is the SMLIGHT default"
                    },
                    {
                        "key":  "RCP_BAUDRATE",
                        "default":  "460800",
                        "description":  "Radio baud rate; halve it if the link is unstable"
                    },
                    {
                        "key":  "OTBR_BACKBONE_IF",
                        "default":  "eth0",
                        "description":  "Host network interface Thread is bridged to (e.g. eth0, enp3s0)"
                    },
                    {
                        "key":  "OTBR_REST_LISTEN_ADDRESS",
                        "default":  "0.0.0.0",
                        "description":  "REST API listen address. The API is unauthenticated: use 127.0.0.1 when Home Assistant runs with host networking, otherwise the host LAN IP"
                    },
                    {
                        "key":  "OTBR_REST_LISTEN_PORT",
                        "default":  "8081",
                        "description":  "REST API port; add http://<host>:<port> in the Home Assistant OTBR integration"
                    },
                    {
                        "key":  "OTBR_WEB_ENABLE",
                        "default":  "0",
                        "description":  "Web UI (1 or 0)"
                    },
                    {
                        "key":  "OTBR_WEB_PORT",
                        "default":  "8080",
                        "description":  "Web UI port"
                    },
                    {
                        "key":  "OTBR_THREAD_IF",
                        "default":  "wpan0",
                        "description":  "Thread interface the router creates; change it only to run two routers on one host"
                    },
                    {
                        "key":  "OTBR_LOG_LEVEL_INT",
                        "default":  "6",
                        "description":  "Log level, 0-7 (6 = info)"
                    }
                ],
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    },
    "composeOverride":  "# Generated by McHarbor App Store\nservices:\n  {{serviceName}}:\n    image: {{image}}\n    container_name: {{containerName}}\n    restart: unless-stopped\n    network_mode: host\n    cap_add:\n      - NET_ADMIN\n      - NET_RAW\n    devices:\n      - /dev/net/tun:/dev/net/tun\n{{volumes}}\n{{environment}}\n"
}
