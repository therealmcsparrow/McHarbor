{
    "slug":  "kopia-unstable",
    "name":  "Kopia (Unstable)",
    "description":  "Unstable channel build of Kopia. Fast encrypted backup tool with a web UI.",
    "category":  "Backups",
    "image":  "kopia/kopia:unstable",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/kopia.png",
    "website":  "https://kopia.io",
    "docsUrl":  "https://kopia.io/docs",
    "ports":  [
                  {
                      "host":  52515,
                      "container":  51515,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/kopia-unstable/config",
                        "container":  "/app/config"
                    },
                    {
                        "host":  "/opt/appdata/kopia-unstable/cache",
                        "container":  "/app/cache"
                    },
                    {
                        "host":  "/srv",
                        "container":  "/data",
                        "readOnly":  true
                    },
                    {
                        "host":  "/srv/backups/kopia",
                        "container":  "/repository"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "version":  "unstable",
    "latest":  {
        "version":  "unstable",
        "release_date":  "2026-09-29"
    },
    "composeOverride":  "# Generated by McHarbor App Store\nservices:\n  {{serviceName}}:\n    image: {{image}}\n    container_name: {{containerName}}\n    restart: unless-stopped\n{{ports}}\n    volumes:\n      - {{appDataPath}}/config:/app/config\n      - {{appDataPath}}/cache:/app/cache\n      - /srv:/data:ro\n      - /srv/backups/kopia:/repository\n    command: server start --insecure --address=0.0.0.0:51515 --server-username=admin --server-password=change-me\n"
}
