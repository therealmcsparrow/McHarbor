{
    "slug":  "scada-lts",
    "name":  "Scada-LTS",
    "description":  "Java-based open-source SCADA system for monitoring and controlling industrial devices over Modbus, BACnet and OPC.",
    "category":  "IoT & Industrial",
    "image":  "scadalts/scadalts:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/scada-lts.png",
    "website":  "https://www.scada-lts.org",
    "docsUrl":  "https://github.com/SCADA-LTS/Scada-LTS/wiki/Docker",
    "ports":  [
                  {
                      "host":  8080,
                      "container":  8080,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/scada-lts/data",
                        "container":  "/usr/local/tomcat/webapps/Scada-LTS/WEB-INF/classes"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "minMemory":  "1GB",
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
