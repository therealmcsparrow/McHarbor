{
    "slug":  "openkm",
    "name":  "OpenKM",
    "description":  "Enterprise document and content management system with workflow, records management, and OCR.",
    "category":  "Documents",
    "image":  "openkm/openkm-ce:latest",
    "logo":  "https://www.openkm.com/favicon.ico",
    "website":  "https://www.openkm.com",
    "docsUrl":  "https://docs.openkm.com/kcenter/view/okm-6/installation-guide.html",
    "ports":  [
                  {
                      "host":  8106,
                      "container":  8080,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/openkm/data",
                        "container":  "/openkm-data"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "minMemory":  "2GB",
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
