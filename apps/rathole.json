{
    "slug":  "rathole",
    "name":  "Rathole",
    "description":  "Lightweight reverse tunnel for exposing services behind NAT or a firewall.",
    "category":  "Networking",
    "image":  "rapiz1/rathole:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/rathole.png",
    "website":  "https://github.com/rapiz1/rathole",
    "docsUrl":  "https://github.com/rapiz1/rathole",
    "ports":  [
                  {
                      "host":  2333,
                      "container":  2333,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/rathole/config",
                        "container":  "/app/config"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
