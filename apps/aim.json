{
    "slug":  "aim",
    "name":  "Aim",
    "description":  "Self-hosted experiment tracker for logging and comparing machine learning training runs and metrics.",
    "category":  "Developer Tools",
    "image":  "aimstack/aim:latest",
    "logo":  "https://avatars.githubusercontent.com/u/61540829?s=200&v=4",
    "website":  "https://aimstack.io",
    "docsUrl":  "https://aimstack.readthedocs.io/en/latest/using/remote_tracking.html",
    "ports":  [
                  {
                      "host":  43800,
                      "container":  43800,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/aim/repo",
                        "container":  "/opt/aim"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "minMemory":  "1GB",
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    },
    "composeOverride":  "# Generated by McHarbor App Store\nservices:\n  {{serviceName}}:\n    image: {{image}}\n    container_name: {{containerName}}\n    restart: unless-stopped\n{{ports}}\n    command: \"aim up --host 0.0.0.0 --port 43800 --repo /opt/aim\"\n    environment:\n      TZ: {{env.TZ}}\n    volumes:\n      - {{appDataPath}}/repo:/opt/aim\n"
}
