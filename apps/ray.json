{
    "slug":  "ray",
    "name":  "Ray",
    "description":  "Distributed compute framework and dashboard for scaling Python workloads, model training, and Ray Serve inference.",
    "category":  "Developer Tools",
    "image":  "rayproject/ray:latest",
    "logo":  "https://cdn.simpleicons.org/ray",
    "website":  "https://www.ray.io",
    "docsUrl":  "https://docs.ray.io/en/latest/ray-overview/installation.html",
    "ports":  [
                  {
                      "host":  8265,
                      "container":  8265,
                      "protocol":  "tcp"
                  },
                  {
                      "host":  6380,
                      "container":  6379,
                      "protocol":  "tcp"
                  },
                  {
                      "host":  10001,
                      "container":  10001,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/ray/data",
                        "container":  "/home/ray/data"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "minMemory":  "4GB",
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    },
    "composeOverride":  "# Generated by McHarbor App Store\nservices:\n  {{serviceName}}:\n    image: {{image}}\n    container_name: {{containerName}}\n    restart: unless-stopped\n{{ports}}\n    command: \"ray start --head --dashboard-host=0.0.0.0 --block\"\n    environment:\n      TZ: {{env.TZ}}\n    volumes:\n      - {{appDataPath}}/data:/home/ray/data\n"
}
