{
    "slug":  "apache-druid",
    "name":  "Apache Druid",
    "description":  "Real-time analytics database designed for fast slice-and-dice OLAP queries on event-driven data.",
    "category":  "Analytics",
    "image":  "apache/druid:30.0.0",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/apache-druid.png",
    "website":  "https://druid.apache.org",
    "docsUrl":  "https://druid.apache.org/docs/latest/tutorials/docker/",
    "ports":  [
                  {
                      "host":  8888,
                      "container":  8888,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/apache-druid/data",
                        "container":  "/opt/data"
                    },
                    {
                        "host":  "/opt/appdata/apache-druid/var",
                        "container":  "/opt/druid/var"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    },
                    {
                        "key":  "DRUID_XMX",
                        "default":  "1g",
                        "description":  "Max JVM heap size"
                    },
                    {
                        "key":  "DRUID_XMS",
                        "default":  "1g",
                        "description":  "Initial JVM heap size"
                    }
                ],
    "minMemory":  "4GB",
    "version":  "30.0.0",
    "latest":  {
        "version":  "30.0.0",
        "release_date":  "2026-09-29"
    },
    "composeOverride":  "# Generated by McHarbor App Store\nservices:\n  {{serviceName}}:\n    image: {{image}}\n    container_name: {{containerName}}\n    restart: unless-stopped\n{{ports}}\n    command: bin/start-single-server-small\n    environment:\n      TZ: {{env.TZ}}\n      DRUID_XMX: {{env.DRUID_XMX}}\n      DRUID_XMS: {{env.DRUID_XMS}}\n    volumes:\n      - {{appDataPath}}/data:/opt/data\n      - {{appDataPath}}/var:/opt/druid/var\n"
}
