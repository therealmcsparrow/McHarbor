{
    "slug":  "node-exporter",
    "name":  "Node Exporter",
    "description":  "Prometheus exporter for host hardware and OS metrics.",
    "category":  "Monitoring",
    "image":  "prom/node-exporter:latest",
    "logo":  "https://www.google.com/s2/favicons?domain=prometheus.io\u0026sz=128",
    "website":  "https://prometheus.io/docs/guides/node-exporter/",
    "docsUrl":  "https://prometheus.io/docs/guides/node-exporter/",
    "ports":  [
                  {
                      "host":  9100,
                      "container":  9100,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/proc",
                        "container":  "/host/proc",
                        "readOnly":  true
                    },
                    {
                        "host":  "/sys",
                        "container":  "/host/sys",
                        "readOnly":  true
                    },
                    {
                        "host":  "/",
                        "container":  "/rootfs",
                        "readOnly":  true
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-10"
    }
}
