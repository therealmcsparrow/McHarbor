    "docsUrl":  "https://github.com/gitleaks/gitleaks#docker",
    "ports":  [

              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/gitleaks/repo",
                        "container":  "/repo"
                    },
                    {
                        "host":  "/opt/appdata/gitleaks/report",
                        "container":  "/report"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "version":  "latest",
