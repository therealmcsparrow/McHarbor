{
    "slug":  "grist",
    "name":  "Grist",
    "description":  "Relational spreadsheet application that combines database power with spreadsheet flexibility.",
    "category":  "Productivity",
    "image":  "gristlabs/grist:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/grist.png",
    "website":  "https://www.getgrist.com",
    "docsUrl":  "https://support.getgrist.com/self-managed/",
    "ports":  [
                  {
                      "host":  8114,
                      "container":  8484,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/grist/data",
                        "container":  "/persist"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    },
                    {
                        "key":  "SESSION_SECRET",
                        "default":  "change-me",
                        "description":  "Session signing secret",
                        "secret":  true
                    },
                    {
                        "key":  "APP_HOME_URL",
                        "default":  "http://localhost:8114",
                        "description":  "Public URL"
                    }
                ],
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
