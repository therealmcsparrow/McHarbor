{
    "slug":  "jellystat-unstable",
    "name":  "Jellystat (Unstable)",
    "description":  "Unstable channel build of Jellystat. Statistics and playback history dashboard for Jellyfin, backed by PostgreSQL.",
    "category":  "Media",
    "image":  "cyfershepard/jellystat:unstable",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/jellystat.png",
    "website":  "https://github.com/CyferShepard/Jellystat",
    "docsUrl":  "https://github.com/CyferShepard/Jellystat#getting-started-with-development",
    "ports":  [
                  {
                      "host":  4017,
                      "container":  3000,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/jellystat-unstable/backup-data",
                        "container":  "/app/backend/backup-data"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    },
                    {
                        "key":  "POSTGRES_USER",
                        "default":  "jellystat",
                        "description":  "PostgreSQL user"
                    },
                    {
                        "key":  "POSTGRES_PASSWORD",
                        "default":  "change-me",
                        "description":  "PostgreSQL password",
                        "secret":  true
                    },
                    {
                        "key":  "POSTGRES_IP",
                        "default":  "jellystat-db",
                        "description":  "PostgreSQL host (the bundled database service)"
                    },
                    {
                        "key":  "POSTGRES_PORT",
                        "default":  "5432",
                        "description":  "PostgreSQL port"
                    },
                    {
                        "key":  "JWT_SECRET",
                        "default":  "change-me-to-a-long-random-string",
                        "description":  "Secret used to sign login sessions",
                        "secret":  true
                    },
                    {
                        "key":  "JELLYSTAT_DB_VOLUME",
                        "default":  "/opt/appdata/jellystat/postgres:/var/lib/postgresql/data",
                        "description":  "PostgreSQL bind mount in host:container format"
                    }
                ],
    "version":  "unstable",
    "latest":  {
        "version":  "unstable",
        "release_date":  "2026-09-29"
    },
    "composeOverride":  "# Generated by McHarbor App Store\nservices:\n  {{serviceName}}:\n    image: {{image}}\n    container_name: {{containerName}}\n    restart: unless-stopped\n    depends_on:\n      - {{serviceName}}-db\n{{ports}}\n{{volumes}}\n{{environment}}\n  {{serviceName}}-db:\n    image: postgres:16-alpine\n    container_name: {{containerName}}-db\n    restart: unless-stopped\n    volumes:\n      - {{env.JELLYSTAT_DB_VOLUME}}\n    environment:\n      POSTGRES_USER: {{env.POSTGRES_USER}}\n      POSTGRES_PASSWORD: {{env.POSTGRES_PASSWORD}}\n"
}
