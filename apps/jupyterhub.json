{
    "slug":  "jupyterhub",
    "name":  "JupyterHub",
    "description":  "Multi-user server that spawns, manages, and proxies individual Jupyter notebook servers for a team.",
    "category":  "Developer Tools",
    "image":  "quay.io/jupyterhub/jupyterhub:latest",
    "logo":  "https://www.google.com/s2/favicons?domain=jupyter.org\u0026sz=128",
    "website":  "https://jupyter.org/hub",
    "docsUrl":  "https://jupyterhub.readthedocs.io/en/stable/tutorial/quickstart-docker.html",
    "ports":  [
                  {
                      "host":  8000,
                      "container":  8000,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/jupyterhub/data",
                        "container":  "/srv/jupyterhub"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "minMemory":  "1GB",
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
