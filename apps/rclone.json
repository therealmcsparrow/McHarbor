{
    "slug":  "rclone",
    "name":  "Rclone",
    "description":  "Cloud storage sync and mount tool with a web UI mode.",
    "category":  "Backups",
    "image":  "rclone/rclone:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/rclone.png",
    "website":  "https://rclone.org",
    "docsUrl":  "https://rclone.org/docs/",
    "ports":  [
                  {
                      "host":  5572,
                      "container":  5572,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/rclone/config",
                        "container":  "/config/rclone"
                    },
                    {
                        "host":  "/srv",
                        "container":  "/data"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "version":  "latest",
    "composeOverride":  "# Generated by McHarbor App Store\nservices:\n  {{serviceName}}:\n    image: {{image}}\n    container_name: {{containerName}}\n    restart: unless-stopped\n{{ports}}\n    volumes:\n      - {{appDataPath}}/config:/config/rclone\n      - /srv:/data\n    command: rcd --rc-web-gui --rc-addr :5572 --rc-user admin --rc-pass change-me\n"
}
