{
  "slug": "forgejo",
  "name": "Forgejo",
  "description": "Lightweight self-hosted Git forge.",
  "category": "Developer Tools",
  "image": "codeberg.org/forgejo/forgejo:latest",
  "logo": "https://cdn.jsdelivr.net/gh/walkxcode/dashboard-icons@master/svg/forgejo.svg",
  "website": "https://forgejo.org",
  "docsUrl": "https://forgejo.org/docs/latest/admin/installation-docker/",
  "ports": [
    {
      "host": 3000,
      "container": 3000,
      "protocol": "tcp"
    },
    {
      "host": 2222,
      "container": 22,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "host": "/opt/appdata/forgejo/data",
      "container": "/data"
    }
  ],
  "envVars": [
    {
      "key": "TZ",
      "default": "Etc/UTC",
      "description": "Timezone"
    },
    {
      "key": "USER_UID",
      "default": "1000",
      "description": "User ID"
    },
    {
      "key": "USER_GID",
      "default": "1000",
      "description": "Group ID"
    }
  ],
  "version": "latest"
}
