{
    "slug":  "agent-dvr",
    "name":  "Agent DVR",
    "description":  "Cross-platform NVR from the iSpy project for recording and monitoring IP cameras with motion and object detection.",
    "category":  "Home Automation",
    "image":  "ispysoftware/agentdvr:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/selfhst/icons/svg/agent-dvr.svg",
    "website":  "https://www.ispyconnect.com/download",
    "docsUrl":  "https://doc.ispyconnect.com/agent-docker.html",
    "ports":  [
                  {
                      "host":  8090,
                      "container":  8090,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/agent-dvr/media",
                        "container":  "/AgentDVR/Media"
                    },
                    {
                        "host":  "/opt/appdata/agent-dvr/config",
                        "container":  "/AgentDVR/Config"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
