                        "host":  "/opt/appdata/kavita-nightly/config",
                        "container":  "/kavita/config"
                    },
                    {
                        "host":  "/srv/books",
                        "container":  "/books"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
