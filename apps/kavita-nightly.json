{
    "slug":  "kavita-nightly",
    "name":  "Kavita (Nightly)",
    "description":  "Nightly channel build of Kavita. Reading server for manga, comics, and ebooks.",
    "category":  "Media",
    "image":  "jvmilazz0/kavita:nightly",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/kavita.png",
