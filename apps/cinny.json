{
    "slug":  "cinny",
    "name":  "Cinny",
    "description":  "Web client for Matrix with a clean interface focused on privacy and simplicity.",
    "category":  "Communications",
    "image":  "ghcr.io/cinnyapp/cinny:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/cinny.png",
    "website":  "https://cinny.in",
    "docsUrl":  "https://github.com/cinnyapp/cinny/blob/dev/docs/docker.md",
    "ports":  [
                  {
                      "host":  8054,
                      "container":  80,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/cinny/config",
                        "container":  "/app/config.json"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "minMemory":  "128MB",
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
