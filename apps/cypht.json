{
    "slug":  "cypht",
    "name":  "Cypht",
    "description":  "Lightweight webmail client that aggregates multiple IMAP, POP3 and news accounts into one inbox.",
    "category":  "Communications",
    "image":  "cypht/cypht:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/selfhst/icons/svg/cypht.svg",
    "website":  "https://cypht.org",
    "docsUrl":  "https://demo.cypht.org/docs/docker.html",
    "ports":  [
                  {
                      "host":  8052,
                      "container":  80,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/cypht/data",
                        "container":  "/var/www/html/data"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "minMemory":  "128MB",
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
