{
    "slug":  "pgpool2",
    "name":  "Pgpool-II",
    "description":  "Middleware that sits in front of PostgreSQL for connection pooling, load balancing and replication management.",
    "category":  "Databases",
    "image":  "pgpool/pgpool:latest",
    "logo":  "https://github.com/pgpool.png",
    "website":  "https://www.pgpool.net",
    "docsUrl":  "https://www.pgpool.net/docs/latest/en/html/tutorial-docker.html",
    "ports":  [
                  {
                      "host":  9999,
                      "container":  9999,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/pgpool2/config",
                        "container":  "/config"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    },
                    {
                        "key":  "PGPOOL_BACKEND_NODES",
                        "default":  "0:postgres:5432",
                        "description":  "Comma-separated list of backend Postgres nodes"
                    },
                    {
                        "key":  "PGPOOL_POSTGRES_USERNAME",
                        "default":  "postgres",
                        "description":  "Postgres username used for health checks"
                    },
                    {
                        "key":  "PGPOOL_POSTGRES_PASSWORD",
                        "default":  "change-me",
                        "description":  "Postgres password used for health checks",
                        "secret":  true
                    },
                    {
                        "key":  "PGPOOL_SR_CHECK_PASSWORD",
                        "default":  "change-me",
                        "description":  "Streaming replication check password",
                        "secret":  true
                    }
                ],
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
