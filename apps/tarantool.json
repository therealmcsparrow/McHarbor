{
    "slug":  "tarantool",
    "name":  "Tarantool",
    "description":  "In-memory database and Lua application server for high-performance data processing.",
    "category":  "Databases",
    "image":  "tarantool/tarantool:latest",
    "logo":  "https://www.google.com/s2/favicons?domain=www.tarantool.io\u0026sz=128",
    "website":  "https://www.tarantool.io",
    "docsUrl":  "https://www.tarantool.io/en/doc/latest/",
    "ports":  [
                  {
                      "host":  3301,
                      "container":  3301,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/tarantool/data",
                        "container":  "/var/lib/tarantool"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TARANTOOL_USER",
                        "default":  "admin",
                        "description":  "Admin username"
                    },
                    {
                        "key":  "TARANTOOL_PASSWORD",
                        "default":  "",
                        "description":  "Admin password",
                        "secret":  true
                    }
                ],
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-10"
    }
}
