{
    "slug":  "cortex",
    "name":  "Cortex",
    "description":  "Horizontally scalable, multi-tenant long-term storage for Prometheus metrics, run here as a single all-in-one node.",
    "category":  "Monitoring",
    "image":  "quay.io/cortexproject/cortex:v1.17.1",
    "logo":  "https://github.com/cortexproject.png",
    "website":  "https://cortexmetrics.io",
    "docsUrl":  "https://cortexmetrics.io/docs/getting-started/",
    "ports":  [
                  {
                      "host":  9009,
                      "container":  9009,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/cortex/config",
                        "container":  "/etc/cortex"
                    },
                    {
                        "host":  "/opt/appdata/cortex/data",
                        "container":  "/data"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "minMemory":  "1GB",
    "version":  "v1.17.1",
    "latest":  {
        "version":  "v1.17.1",
        "release_date":  "2026-09-29"
    },
    "composeOverride":  "# Generated by McHarbor App Store\nservices:\n  {{serviceName}}:\n    image: {{image}}\n    container_name: {{containerName}}\n    restart: unless-stopped\n{{ports}}\n    command: \"-config.file=/etc/cortex/cortex.yaml -target=all\"\n    environment:\n      TZ: {{env.TZ}}\n    volumes:\n      - {{appDataPath}}/config:/etc/cortex\n      - {{appDataPath}}/data:/data\n"
}
