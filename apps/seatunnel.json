{
    "slug":  "seatunnel",
    "name":  "Apache SeaTunnel",
    "description":  "Distributed data integration engine for high-volume batch and streaming ETL between databases, queues, and files.",
    "category":  "Analytics",
    "image":  "apache/seatunnel:2.3.9",
    "logo":  "https://www.google.com/s2/favicons?domain=seatunnel.apache.org\u0026sz=128",
    "website":  "https://seatunnel.apache.org",
    "docsUrl":  "https://seatunnel.apache.org/docs/2.3.9/start-v2/docker/",
    "ports":  [
                  {
                      "host":  5801,
                      "container":  5801,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/seatunnel/config",
                        "container":  "/opt/seatunnel/config"
                    },
                    {
                        "host":  "/opt/appdata/seatunnel/jobs",
                        "container":  "/opt/seatunnel/jobs"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "minMemory":  "2GB",
    "version":  "2.3.9",
    "latest":  {
        "version":  "2.3.9",
        "release_date":  "2026-09-29"
    },
    "composeOverride":  "# Generated by McHarbor App Store\nservices:\n  {{serviceName}}:\n    image: {{image}}\n    container_name: {{containerName}}\n    restart: unless-stopped\n{{ports}}\n    command: ./bin/seatunnel-cluster.sh\n    environment:\n      TZ: {{env.TZ}}\n    volumes:\n      - {{appDataPath}}/config:/opt/seatunnel/config\n      - {{appDataPath}}/jobs:/opt/seatunnel/jobs\n"
}
