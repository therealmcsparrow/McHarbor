{
  "slug": "mysql",
  "name": "MySQL",
  "description": "World's most popular open-source relational database management system.",
  "category": "Databases",
  "image": "mysql:8",
  "logo": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/mysql.png",
  "website": "https://www.mysql.com",
  "docsUrl": "https://dev.mysql.com/doc/",
  "ports": [
    {
      "host": 3306,
      "container": 3306,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "host": "/opt/appdata/mysql/data",
      "container": "/var/lib/mysql"
    }
  ],
  "envVars": [
    {
      "key": "MYSQL_ROOT_PASSWORD",
      "default": "",
      "description": "Root password",
      "secret": true
    },
    {
      "key": "MYSQL_DATABASE",
      "default": "mydb",
      "description": "Default database name"
    },
    {
      "key": "MYSQL_USER",
      "default": "user",
      "description": "Database user"
    },
    {
      "key": "MYSQL_PASSWORD",
      "default": "",
      "description": "Database user password",
      "secret": true
    }
  ],
  "version": "8"
}