{
    "slug":  "opengauss",
    "name":  "openGauss",
    "description":  "Enterprise relational database forked from Postgres with built-in high availability, security and AI-assisted tuning.",
    "category":  "Databases",
    "image":  "opengauss/opengauss:latest",
    "logo":  "https://github.com/opengauss-mirror.png",
    "website":  "https://opengauss.org",
    "docsUrl":  "https://docs.opengauss.org/en/docs/latest/docs/InstallationGuide/installing-opengauss-by-container.html",
    "ports":  [
                  {
                      "host":  5433,
                      "container":  5432,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/opengauss/data",
                        "container":  "/var/lib/opengauss/data"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    },
                    {
                        "key":  "GS_PASSWORD",
                        "default":  "change-me",
                        "description":  "Password for the default openGauss superuser",
                        "secret":  true
                    }
                ],
    "minMemory":  "1GB",
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
