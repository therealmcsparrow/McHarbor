{
    "slug":  "gladys-assistant",
    "name":  "Gladys Assistant",
    "description":  "Privacy-focused home automation hub that runs entirely locally and integrates Zigbee, Z-Wave and MQTT devices.",
    "category":  "Home Automation",
    "image":  "gladysassistant/gladys:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/gladys-assistant.png",
    "website":  "https://gladysassistant.com",
    "docsUrl":  "https://doc.gladysassistant.com/docs/installation/docker",
    "ports":  [
                  {
                      "host":  80,
                      "container":  80,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/gladys-assistant/data",
                        "container":  "/var/lib/gladysassistant"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    },
                    {
                        "key":  "ACCESS_TOKEN_SECRET",
                        "default":  "change-me",
                        "description":  "Secret used to sign session tokens",
                        "secret":  true
                    },
                    {
                        "key":  "REFRESH_TOKEN_SECRET",
                        "default":  "change-me",
                        "description":  "Secret used to sign refresh tokens",
                        "secret":  true
                    }
                ],
    "minMemory":  "512MB",
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
