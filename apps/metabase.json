{
  "slug": "metabase",
  "name": "Metabase",
  "description": "Open-source business intelligence platform with dashboards, queries, and visualizations.",
  "category": "Databases",
  "image": "metabase/metabase:latest",
  "logo": "https://www.metabase.com/images/logo.svg",
  "website": "https://www.metabase.com",
  "docsUrl": "https://www.metabase.com/docs/latest/installation-and-operation/running-metabase-on-docker.html",
  "ports": [
    {
      "host": 3000,
      "container": 3000,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "host": "/opt/appdata/metabase/data",
      "container": "/metabase-data"
    }
  ],
  "envVars": [
    {
      "key": "MB_DB_TYPE",
      "default": "postgres",
      "description": "Application database type"
    },
    {
      "key": "MB_DB_HOST",
      "default": "postgres",
      "description": "Application database host"
    },
    {
      "key": "MB_DB_PORT",
      "default": "5432",
      "description": "Application database port"
    },
    {
      "key": "MB_DB_DB_NAME",
      "default": "metabase",
      "description": "Application database name"
    },
    {
      "key": "MB_DB_USER",
      "default": "metabase",
      "description": "Application database user"
    },
    {
      "key": "MB_DB_PASS",
      "default": "",
      "description": "Application database password",
      "secret": true
    },
    {
      "key": "TZ",
      "default": "Etc/UTC",
      "description": "Timezone"
    }
  ],
  "version": "latest"
}
