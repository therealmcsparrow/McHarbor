{
    "slug":  "go-122-dev",
    "name":  "Go 1.22",
    "description":  "Go 1.22 on Alpine Linux, statically typed compiled language with range over integers and improved routing.",
    "category":  "Developer Tools",
    "image":  "golang:1.22-alpine",
    "logo":  "https://icon.horse/icon/go.dev",
    "website":  "https://go.dev",
    "docsUrl":  "https://go.dev/doc/",
    "ports":  [
                  {
                      "host":  80,
                      "container":  80,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/go-122-dev/app",
                        "container":  "/go/src/app"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    },
                    {
                        "key":  "GO111MODULE",
                        "default":  "on",
                        "description":  "Enable Go modules"
                    },
                    {
                        "key":  "CGO_ENABLED",
                        "default":  "0",
                        "description":  "Disable CGO for static binaries"
                    }
                ],
    "version":  "1.22-alpine"
}
