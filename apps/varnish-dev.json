{
    "slug":  "varnish-dev",
    "name":  "Varnish Dev",
    "description":  "Varnish HTTP accelerator for local caching and CDN behavior testing.",
    "category":  "Developer Tools",
    "image":  "varnish:latest",
    "logo":  "https://www.google.com/s2/favicons?domain=varnish-cache.org\u0026sz=128",
    "website":  "https://varnish-cache.org",
    "docsUrl":  "https://hub.docker.com/_/varnish",
    "ports":  [
                  {
                      "host":  80,
                      "container":  80,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/varnish-dev/config",
                        "container":  "/etc/varnish"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    },
                    {
                        "key":  "VARNISH_SIZE",
                        "default":  "256M",
                        "description":  "Cache size"
                    }
                ],
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-10"
    }
}
