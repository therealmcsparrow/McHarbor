{
    "slug":  "lidarr-preview",
    "name":  "Lidarr (Preview)",
    "description":  "Preview channel build of Lidarr. Music collection manager for Usenet and BitTorrent users.",
    "category":  "Media",
    "image":  "lscr.io/linuxserver/lidarr:preview",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/lidarr.png",
    "website":  "https://docs.linuxserver.io/images/docker-lidarr/",
    "docsUrl":  "https://docs.linuxserver.io/images/docker-lidarr/",
    "ports":  [
                  {
                      "host":  9686,
                      "container":  8686,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/lidarr-preview/config",
                        "container":  "/config"
                    },
                    {
                        "host":  "/srv/media",
                        "container":  "/media"
                    },
                    {
                        "host":  "/srv/downloads",
                        "container":  "/downloads"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    },
                    {
                        "key":  "PUID",
                        "default":  "1000",
                        "description":  "User ID"
                    },
                    {
                        "key":  "PGID",
                        "default":  "1000",
                        "description":  "Group ID"
                    }
                ],
    "version":  "preview",
    "latest":  {
        "version":  "preview",
        "release_date":  "2026-09-29"
    }
}
