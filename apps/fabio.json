{
  "slug": "fabio",
  "name": "Fabio",
  "description": "Consul-based HTTP and TCP load balancer with automatic service registration.",
  "category": "Networking",
  "image": "fabiolb/fabio:latest",
  "logo": "https://www.google.com/s2/favicons?domain=fabiolb.net\u0026sz=128",
  "website": "https://fabiolb.net",
  "docsUrl": "https://fabiolb.net/quickstart/",
  "ports": [
    {
      "host": 80,
      "container": 80,
      "protocol": "tcp"
    },
    {
      "host": 9999,
      "container": 9999,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "host": "/opt/appdata/fabio/config",
      "container": "/etc/fabio"
    }
  ],
  "envVars": [
    {
      "key": "TZ",
      "default": "Etc/UTC",
      "description": "Timezone"
    }
  ],
  "version":  "latest",
  "latest":  {
      "version":  "latest",
      "release_date":  "2026-09-10"
  }
}