{
    "slug":  "torchserve",
    "name":  "TorchServe",
    "description":  "Model serving framework for deploying and scaling PyTorch models behind a REST and gRPC inference API.",
    "category":  "Developer Tools",
    "image":  "pytorch/torchserve:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/pytorch.png",
    "website":  "https://pytorch.org/serve/",
    "docsUrl":  "https://github.com/pytorch/serve/blob/master/docker/README.md",
    "ports":  [
                  {
                      "host":  8080,
                      "container":  8080,
                      "protocol":  "tcp"
                  },
                  {
                      "host":  8081,
                      "container":  8081,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/torchserve/model-store",
                        "container":  "/home/model-server/model-store"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "minMemory":  "2GB",
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
