{
    "slug":  "teamcity-server",
    "name":  "TeamCity Server",
    "description":  "JetBrains continuous integration and delivery server for building, testing and deploying software.",
    "category":  "CI/CD",
    "image":  "jetbrains/teamcity-server:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/teamcity.png",
    "website":  "https://www.jetbrains.com/teamcity/",
    "docsUrl":  "https://www.jetbrains.com/help/teamcity/docker.html",
    "ports":  [
                  {
                      "host":  8111,
                      "container":  8111,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/teamcity-server/datadir",
                        "container":  "/data/teamcity_server/datadir"
                    },
                    {
                        "host":  "/opt/appdata/teamcity-server/logs",
                        "container":  "/opt/teamcity/logs"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "minMemory":  "4GB",
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
