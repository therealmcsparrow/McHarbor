{
    "slug":  "iobroker-dev",
    "name":  "ioBroker (Dev)",
    "description":  "Dev channel build of ioBroker. IoT automation platform with a rich adapter ecosystem and visualization.",
    "category":  "Home Automation",
    "image":  "buanet/iobroker:dev",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/iobroker.png",
    "website":  "https://www.iobroker.net",
    "docsUrl":  "https://docs.iobroker.net/en/install/docker.html",
    "ports":  [
                  {
                      "host":  9081,
                      "container":  8081,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/iobroker-dev/iobroker-data",
                        "container":  "/opt/iobroker/iobroker-data"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "version":  "dev",
    "latest":  {
        "version":  "dev",
        "release_date":  "2026-09-29"
    }
}
