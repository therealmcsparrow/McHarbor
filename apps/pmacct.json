{
    "slug":  "pmacct",
    "name":  "pmacct",
    "description":  "Collects and accounts for network traffic using NetFlow, sFlow, and IPFIX.",
    "category":  "Networking",
    "image":  "pmacct/nfacctd:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/pmacct.png",
    "website":  "http://www.pmacct.net/",
    "docsUrl":  "http://www.pmacct.net/",
    "ports":  [
                  {
                      "host":  2100,
                      "container":  2100,
                      "protocol":  "udp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/pmacct/config",
                        "container":  "/etc/pmacct"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
