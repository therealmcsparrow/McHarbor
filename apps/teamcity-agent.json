{
    "slug":  "teamcity-agent",
    "name":  "TeamCity Build Agent",
    "description":  "Build agent that connects outbound to a TeamCity server and executes its assigned build steps.",
    "category":  "CI/CD",
    "image":  "jetbrains/teamcity-agent:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/teamcity.png",
    "website":  "https://www.jetbrains.com/teamcity/",
    "docsUrl":  "https://www.jetbrains.com/help/teamcity/set-up-build-agents-on-docker.html",
    "ports":  [

              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/teamcity-agent/conf",
                        "container":  "/data/teamcity_agent/conf"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    },
                    {
                        "key":  "SERVER_URL",
                        "default":  "http://teamcity-server:8111",
                        "description":  "URL of the TeamCity server this agent registers with"
                    }
                ],
    "minMemory":  "2GB",
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
