{
    "slug":  "homebridge-beta",
    "name":  "Homebridge (Beta)",
    "description":  "Beta channel build of Homebridge. Expose devices to Apple HomeKit through a large plugin ecosystem. Uses host networking for mDNS reliability.",
    "category":  "Home Automation",
    "image":  "homebridge/homebridge:beta",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/homebridge.png",
    "website":  "https://homebridge.io",
    "docsUrl":  "https://github.com/homebridge/docker-homebridge/wiki/Homebridge-on-Docker",
    "ports":  [

              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/homebridge",
                        "container":  "/homebridge"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    },
                    {
                        "key":  "ENABLE_AVAHI",
                        "default":  "1",
                        "description":  "Enable Avahi/mDNS inside the container"
                    }
                ],
    "version":  "beta",
    "latest":  {
        "version":  "beta",
        "release_date":  "2026-09-29"
    },
    "composeOverride":  "# Generated by McHarbor App Store\nservices:\n  {{serviceName}}:\n    image: {{image}}\n    container_name: {{containerName}}\n    restart: unless-stopped\n    network_mode: host\n{{volumes}}\n{{environment}}\n    logging:\n      options:\n        max-size: \"10mb\"\n        max-file: \"1\"\n"
}
