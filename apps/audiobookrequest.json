{
    "slug":  "audiobookrequest",
    "name":  "AudioBookRequest",
    "description":  "Request and wishlist tool for audiobooks that connects to Audiobookshelf, Plex or Jellyfin.",
    "category":  "Media",
    "image":  "markbeep/audiobookrequest:latest",
    "logo":  "https://opengraph.githubassets.com/1/markbeep/AudioBookRequest",
    "website":  "https://github.com/markbeep/AudioBookRequest",
    "docsUrl":  "https://github.com/markbeep/AudioBookRequest#getting-started",
    "ports":  [
                  {
                      "host":  4054,
                      "container":  8000,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/audiobookrequest/config",
                        "container":  "/config"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
