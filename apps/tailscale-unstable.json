{
    "slug":  "tailscale-unstable",
    "name":  "Tailscale (Unstable)",
    "description":  "Unstable channel build of Tailscale. WireGuard-based mesh VPN node that joins this host to your tailnet, with optional subnet routing.",
    "category":  "Networking",
    "image":  "tailscale/tailscale:unstable",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/tailscale.png",
    "website":  "https://tailscale.com",
    "docsUrl":  "https://tailscale.com/kb/1282/docker",
    "ports":  [

              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/tailscale-unstable/state",
                        "container":  "/var/lib/tailscale"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    },
                    {
                        "key":  "TS_AUTHKEY",
                        "default":  "",
                        "description":  "Auth key from the Tailscale admin console",
                        "secret":  true
                    },
                    {
                        "key":  "TS_HOSTNAME",
                        "default":  "mcharbor-tailscale",
                        "description":  "Machine name shown in the tailnet"
                    },
                    {
                        "key":  "TS_STATE_DIR",
                        "default":  "/var/lib/tailscale",
                        "description":  "Where node state is persisted"
                    },
                    {
                        "key":  "TS_USERSPACE",
                        "default":  "false",
                        "description":  "Use userspace networking instead of the kernel TUN device"
                    },
                    {
                        "key":  "TS_EXTRA_ARGS",
                        "default":  "",
                        "description":  "Extra tailscale up flags, e.g. --advertise-exit-node"
                    },
                    {
                        "key":  "TS_ROUTES",
                        "default":  "",
                        "description":  "Comma-separated subnets to advertise, e.g. 192.168.1.0/24"
                    }
                ],
    "version":  "unstable",
    "latest":  {
        "version":  "unstable",
        "release_date":  "2026-09-29"
    },
    "composeOverride":  "# Generated by McHarbor App Store\nservices:\n  {{serviceName}}:\n    image: {{image}}\n    container_name: {{containerName}}\n    hostname: {{env.TS_HOSTNAME}}\n    restart: unless-stopped\n    cap_add:\n      - NET_ADMIN\n      - SYS_MODULE\n    devices:\n      - /dev/net/tun:/dev/net/tun\n{{ports}}\n{{volumes}}\n{{environment}}\n"
}
