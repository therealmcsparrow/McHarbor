{
    "slug":  "gocd-server",
    "name":  "GoCD Server",
    "description":  "Open-source continuous delivery server that models and visualizes complex build and deployment pipelines.",
    "category":  "CI/CD",
    "image":  "gocd/gocd-server:v24.3.0",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/gocd.svg",
    "website":  "https://www.gocd.org",
    "docsUrl":  "https://docs.gocd.org/current/installation/install/server/docker.html",
    "ports":  [
                  {
                      "host":  8153,
                      "container":  8153,
                      "protocol":  "tcp"
                  },
                  {
                      "host":  8154,
                      "container":  8154,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/gocd-server/godata",
                        "container":  "/godata"
                    },
                    {
                        "host":  "/opt/appdata/gocd-server/home",
                        "container":  "/home/go"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "minMemory":  "2GB",
    "version":  "v24.3.0",
    "latest":  {
        "version":  "v24.3.0",
        "release_date":  "2026-09-29"
    }
}
