{
    "slug":  "threadfin",
    "name":  "Threadfin",
    "description":  "IPTV and M3U proxy that merges playlists and EPG data for Plex, Emby and Jellyfin live TV.",
    "category":  "Media",
    "image":  "fyb3roptik/threadfin:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/threadfin.png",
    "website":  "https://github.com/Threadfin/Threadfin",
    "docsUrl":  "https://github.com/Threadfin/Threadfin#docker",
    "ports":  [
                  {
                      "host":  34400,
                      "container":  34400,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/threadfin/config",
                        "container":  "/home/threadfin/conf"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
