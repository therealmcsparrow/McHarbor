{
    "slug":  "librespeed",
    "name":  "LibreSpeed",
    "description":  "Self-hosted internet speed test with a lightweight web interface.",
    "category":  "Networking",
    "image":  "lscr.io/linuxserver/librespeed:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/librespeed.png",
    "website":  "https://librespeed.org/",
    "docsUrl":  "https://docs.linuxserver.io/images/docker-librespeed/",
    "ports":  [
                  {
                      "host":  8095,
                      "container":  80,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/librespeed/config",
                        "container":  "/config"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    },
                    {
                        "key":  "PASSWORD",
                        "default":  "change-me",
                        "description":  "Password protecting the results and admin page",
                        "secret":  true
                    }
                ],
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
