{
    "slug":  "mautrix-discord",
    "name":  "mautrix-discord",
    "description":  "Matrix bridge that connects a Discord account or bot into a Matrix room for two-way messaging.",
    "category":  "Communications",
    "image":  "dock.mau.dev/mautrix/discord:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/discord.png",
    "website":  "https://docs.mau.fi/bridges/go/discord/index.html",
    "docsUrl":  "https://docs.mau.fi/bridges/general/docker-setup.html",
    "ports":  [

              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/mautrix-discord/data",
                        "container":  "/data"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    },
                    {
                        "key":  "HOMESERVER_ADDRESS",
                        "default":  "https://matrix.example.com",
                        "description":  "URL of the Matrix homeserver to bridge into"
                    }
                ],
    "minMemory":  "256MB",
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
