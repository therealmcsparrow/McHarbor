{
    "slug":  "phpmyadmin",
    "name":  "phpMyAdmin",
    "description":  "Web administration UI for MySQL and MariaDB.",
    "category":  "Developer Tools",
    "image":  "phpmyadmin:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/phpmyadmin.png",
    "website":  "https://www.phpmyadmin.net",
    "docsUrl":  "https://hub.docker.com/_/phpmyadmin",
    "ports":  [
                  {
                      "host":  8085,
                      "container":  80,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [

                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    },
                    {
                        "key":  "PMA_ARBITRARY",
                        "default":  "1",
                        "description":  "Allow connecting to arbitrary servers"
                    }
                ],
    "version":  "latest"
}
