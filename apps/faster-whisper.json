{
  "slug": "faster-whisper",
  "name": "Faster Whisper",
  "description": "LinuxServer.io Faster Whisper Wyoming server for local speech-to-text with Home Assistant Assist.",
  "category": "AI & Voice",
  "image": "lscr.io/linuxserver/faster-whisper:latest",
  "logo": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/linuxserver-ls-logo.png",
  "website": "https://hub.docker.com/r/linuxserver/faster-whisper",
  "docsUrl": "https://docs.linuxserver.io/images/docker-faster-whisper/",
  "ports": [
    {
      "host": 10300,
      "container": 10300,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "host": "/opt/appdata/faster-whisper/config",
      "container": "/config"
    }
  ],
  "envVars": [
    {
      "key": "PUID",
      "default": "1000",
      "description": "User ID for file ownership"
    },
    {
      "key": "PGID",
      "default": "1000",
      "description": "Group ID for file ownership"
    },
    {
      "key": "TZ",
      "default": "Etc/UTC",
      "description": "Timezone"
    },
    {
      "key": "DEBUG",
      "default": "",
      "description": "Set to true to enable debug logging"
    },
    {
      "key": "LOCAL_ONLY",
      "default": "",
      "description": "Set to true to use only locally provided models"
    },
    {
      "key": "WHISPER_BEAM",
      "default": "1",
      "description": "Number of transcription candidates to consider"
    },
    {
      "key": "WHISPER_LANG",
      "default": "auto",
      "description": "Two-character language code or auto"
    },
    {
      "key": "WHISPER_MODEL",
      "default": "auto",
      "description": "Whisper model used for transcription"
    }
  ],
  "minMemory": "2GB",
  "version": "latest"
}
