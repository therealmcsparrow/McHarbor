{
    "slug":  "snapcast",
    "name":  "Snapcast",
    "description":  "Synchronized multi-room audio streaming server that plays the same audio in sync on many clients.",
    "category":  "Media",
    "image":  "strm/snapcast:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/snapcast.png",
    "website":  "https://github.com/badaix/snapcast",
    "docsUrl":  "https://github.com/badaix/snapcast/blob/master/doc/README.md",
    "ports":  [
                  {
                      "host":  1704,
                      "container":  1704,
                      "protocol":  "tcp"
                  },
                  {
                      "host":  1705,
                      "container":  1705,
                      "protocol":  "tcp"
                  },
                  {
                      "host":  1780,
                      "container":  1780,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/snapcast/config",
                        "container":  "/config"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
