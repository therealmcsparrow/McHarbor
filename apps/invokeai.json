{
    "slug":  "invokeai",
    "name":  "InvokeAI",
    "description":  "Studio interface for Stable Diffusion image generation with a node editor and unified canvas; requires an NVIDIA GPU.",
    "category":  "AI & Voice",
    "image":  "ghcr.io/invoke-ai/invokeai:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/invokeai.png",
    "website":  "https://invoke-ai.github.io/InvokeAI",
    "docsUrl":  "https://invoke-ai.github.io/InvokeAI/installation/docker/",
    "ports":  [
                  {
                      "host":  9090,
                      "container":  9090,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/invokeai/data",
                        "container":  "/invokeai"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "minMemory":  "6GB",
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
