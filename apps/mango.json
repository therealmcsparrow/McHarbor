{
    "slug":  "mango",
    "name":  "Mango",
    "description":  "Simple self-hosted manga server and reader for a local comics collection.",
    "category":  "Media",
    "image":  "hkalexling/mango:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/mango.png",
    "website":  "https://getmango.xyz",
    "docsUrl":  "https://github.com/getmango/Mango/wiki/Installation",
    "ports":  [
                  {
                      "host":  9000,
                      "container":  9000,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/mango/library",
                        "container":  "/library"
                    },
                    {
                        "host":  "/opt/appdata/mango/data",
                        "container":  "/data"
                    },
                    {
                        "host":  "/opt/appdata/mango/config",
                        "container":  "/config"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
