{
    "slug":  "php-82-dev",
    "name":  "PHP-FPM 8.2",
    "description":  "PHP-FPM 8.2 on Alpine, FastCGI Process Manager for serving PHP behind a web server.",
    "category":  "Developer Tools",
    "image":  "php:8.2-fpm-alpine",
    "logo":  "https://icon.horse/icon/www.php.net",
    "website":  "https://www.php.net",
    "docsUrl":  "https://www.php.net/manual/en/",
    "ports":  [
                  {
                      "host":  9000,
                      "container":  9000,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/php-82-dev/app",
                        "container":  "/var/www/html"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "version":  "8.2-fpm-alpine"
}
