{
  "slug": "hedgedoc",
  "name": "HedgeDoc",
  "description": "Real-time collaborative Markdown editor for notes, slides and diagrams, with PostgreSQL.",
  "category": "Documents",
  "image": "quay.io/hedgedoc/hedgedoc:latest",
  "logo": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/hedgedoc.png",
  "website": "https://hedgedoc.org",
  "docsUrl": "https://docs.hedgedoc.org/setup/docker/",
  "ports": [
    {
      "host": 3029,
      "container": 3000,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "host": "/opt/appdata/hedgedoc/uploads",
      "container": "/hedgedoc/public/uploads"
    }
  ],
  "envVars": [
    {
      "key": "CMD_DOMAIN",
      "default": "localhost",
      "description": "Domain HedgeDoc is served on"
    },
    {
      "key": "CMD_PORT",
      "default": "3000",
      "description": "Listen port inside the container"
    },
    {
      "key": "CMD_URL_ADDPORT",
      "default": "true",
      "description": "Append the port to generated URLs"
    },
    {
      "key": "CMD_PROTOCOL_USESSL",
      "default": "false",
      "description": "Generate https URLs"
    },
    {
      "key": "CMD_SESSION_SECRET",
      "default": "change-me-to-a-long-random-string",
      "description": "Secret used to sign sessions",
      "secret": true
    },
    {
      "key": "CMD_DB_DIALECT",
      "default": "postgres",
      "description": "Database dialect"
    },
    {
      "key": "CMD_DB_HOST",
      "default": "hedgedoc-db",
      "description": "Database host (the bundled PostgreSQL service)"
    },
    {
      "key": "CMD_DB_PORT",
      "default": "5432",
      "description": "Database port"
    },
    {
      "key": "CMD_DB_DATABASE",
      "default": "hedgedoc",
      "description": "Database name"
    },
    {
      "key": "CMD_DB_USERNAME",
      "default": "hedgedoc",
      "description": "Database user"
    },
    {
      "key": "CMD_DB_PASSWORD",
      "default": "change-me",
      "description": "Database password",
      "secret": true
    },
    {
      "key": "HEDGEDOC_DB_VOLUME",
      "default": "/opt/appdata/hedgedoc/postgres:/var/lib/postgresql/data",
      "description": "PostgreSQL bind mount in host:container format"
    }
  ],
  "composeOverride": "# Generated by McHarbor App Store\nservices:\n  {{serviceName}}:\n    image: {{image}}\n    container_name: {{containerName}}\n    restart: unless-stopped\n    depends_on:\n      - {{serviceName}}-db\n{{ports}}\n{{volumes}}\n{{environment}}\n  {{serviceName}}-db:\n    image: postgres:16-alpine\n    container_name: {{containerName}}-db\n    restart: unless-stopped\n    volumes:\n      - {{env.HEDGEDOC_DB_VOLUME}}\n    environment:\n      POSTGRES_DB: {{env.CMD_DB_DATABASE}}\n      POSTGRES_USER: {{env.CMD_DB_USERNAME}}\n      POSTGRES_PASSWORD: {{env.CMD_DB_PASSWORD}}\n",
  "version": "latest",
  "latest": {
    "version": "latest",
    "release_date": "2026-09-27"
  }
}
