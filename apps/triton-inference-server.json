{
    "slug":  "triton-inference-server",
    "name":  "NVIDIA Triton Inference Server",
    "description":  "High-performance inference server for deploying TensorFlow, PyTorch, ONNX, and TensorRT models; requires an NVIDIA GPU.",
    "category":  "Developer Tools",
    "image":  "nvcr.io/nvidia/tritonserver:24.09-py3",
    "logo":  "https://www.google.com/s2/favicons?domain=developer.nvidia.com\u0026sz=128",
    "website":  "https://developer.nvidia.com/triton-inference-server",
    "docsUrl":  "https://github.com/triton-inference-server/server/blob/main/docs/getting_started/quickstart.md",
    "ports":  [
                  {
                      "host":  8000,
                      "container":  8000,
                      "protocol":  "tcp"
                  },
                  {
                      "host":  8001,
                      "container":  8001,
                      "protocol":  "tcp"
                  },
                  {
                      "host":  8002,
                      "container":  8002,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/triton-inference-server/models",
                        "container":  "/models"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "minMemory":  "8GB",
    "version":  "24.09-py3",
    "latest":  {
        "version":  "24.09-py3",
        "release_date":  "2026-09-29"
    },
    "composeOverride":  "# Generated by McHarbor App Store\nservices:\n  {{serviceName}}:\n    image: {{image}}\n    container_name: {{containerName}}\n    restart: unless-stopped\n{{ports}}\n    command: \"tritonserver --model-repository=/models --allow-gpu-metrics=false\"\n    environment:\n      TZ: {{env.TZ}}\n    volumes:\n      - {{appDataPath}}/models:/models\n"
}
