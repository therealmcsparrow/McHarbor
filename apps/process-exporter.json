{
    "slug":  "process-exporter",
    "name":  "Process Exporter",
    "description":  "Prometheus exporter that mines /proc to expose named process metrics and resource usage.",
    "category":  "Monitoring",
    "image":  "ncabatoff/process-exporter:latest",
    "logo":  "https://www.google.com/s2/favicons?domain=github.com\u0026sz=128",
    "website":  "https://github.com/ncabatoff/process-exporter",
    "docsUrl":  "https://github.com/ncabatoff/process-exporter#readme",
    "ports":  [
                  {
                      "host":  9256,
                      "container":  9256,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/process-exporter/config",
                        "container":  "/config"
                    },
                    {
                        "host":  "/proc",
                        "container":  "/proc"
                    },
                    {
                        "host":  "/var/run/docker.sock",
                        "container":  "/var/run/docker.sock"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-10"
    }
}
