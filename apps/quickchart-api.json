{
    "slug":  "quickchart-api",
    "name":  "QuickChart",
    "description":  "Chart and QR code image web API. Generate Chart.js, Plotly, and GraphViz charts as PNG or SVG from simple URL parameters.",
    "category":  "Productivity",
    "image":  "ianw/quickchart:latest",
    "logo":  "https://www.google.com/s2/favicons?domain=quickchart.io\u0026sz=128",
    "website":  "https://quickchart.io",
    "docsUrl":  "https://quickchart.io/documentation",
    "ports":  [
                  {
                      "host":  3400,
                      "container":  3400,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/quickchart-api/data",
                        "container":  "/app/data"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-10"
    }
}
