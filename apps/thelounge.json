{
    "slug":  "thelounge",
    "name":  "The Lounge",
    "description":  "Self-hosted always-on IRC client accessible from a web browser.",
    "category":  "Communications",
    "image":  "thelounge/thelounge:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/thelounge.png",
    "website":  "https://thelounge.chat",
    "docsUrl":  "https://thelounge.chat/docs/install#docker",
    "ports":  [
                  {
                      "host":  8046,
                      "container":  9000,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/thelounge/config",
                        "container":  "/var/opt/thelounge"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "minMemory":  "256MB",
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
