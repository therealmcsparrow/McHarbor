{
    "slug":  "wireshark",
    "name":  "Wireshark",
    "description":  "Network protocol analyzer with a browser-accessible desktop for capturing and inspecting traffic.",
    "category":  "Networking",
    "image":  "linuxserver/wireshark:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/wireshark.png",
    "website":  "https://www.wireshark.org/",
    "docsUrl":  "https://docs.linuxserver.io/images/docker-wireshark/",
    "ports":  [
                  {
                      "host":  3010,
                      "container":  3000,
                      "protocol":  "tcp"
                  },
                  {
                      "host":  3011,
                      "container":  3001,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/wireshark/config",
                        "container":  "/config"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    },
                    {
                        "key":  "PUID",
                        "default":  "1000",
                        "description":  "User ID for file permissions"
                    },
                    {
                        "key":  "PGID",
                        "default":  "1000",
                        "description":  "Group ID for file permissions"
                    }
                ],
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
