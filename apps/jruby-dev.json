{
    "slug":  "jruby-dev",
    "name":  "JRuby",
    "description":  "JRuby on the JVM, Ruby implementation for fast scripting and Java interoperability.",
    "category":  "Developer Tools",
    "image":  "jruby:latest",
    "logo":  "https://www.google.com/s2/favicons?domain=www.jruby.org\u0026sz=128",
    "website":  "https://www.jruby.org",
    "docsUrl":  "https://www.jruby.org/documentation",
