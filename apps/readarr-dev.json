{
    "slug":  "readarr-dev",
    "name":  "Readarr (Dev)",
    "description":  "Dev channel build of Readarr. Book and audiobook collection manager that automates downloading and organizing your library.",
    "category":  "Media",
    "image":  "lscr.io/linuxserver/readarr:develop",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/readarr.png",
    "website":  "https://readarr.com",
    "docsUrl":  "https://docs.linuxserver.io/images/docker-readarr",
    "ports":  [
                  {
                      "host":  9787,
                      "container":  8787,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/readarr-dev/config",
                        "container":  "/config"
                    },
                    {
                        "host":  "/opt/appdata/readarr-dev/books",
                        "container":  "/books"
                    },
                    {
                        "host":  "/opt/appdata/readarr-dev/downloads",
                        "container":  "/downloads"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    },
                    {
                        "key":  "PUID",
                        "default":  "1000",
                        "description":  "User ID that owns the mounted files"
                    },
                    {
                        "key":  "PGID",
                        "default":  "1000",
                        "description":  "Group ID that owns the mounted files"
                    }
                ],
    "version":  "develop",
    "latest":  {
        "version":  "develop",
        "release_date":  "2026-09-29"
    }
}
