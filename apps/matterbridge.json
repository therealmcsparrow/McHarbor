    "category":  "Communications",
    "image":  "42wim/matterbridge:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/matterbridge.png",
    "website":  "https://github.com/42wim/matterbridge",
    "docsUrl":  "https://github.com/42wim/matterbridge/wiki/How-to-run-docker",
    "ports":  [

              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/matterbridge/config",
                        "container":  "/etc/matterbridge"
                    }
                ],
