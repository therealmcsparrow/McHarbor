{
    "slug":  "shiny-server",
    "name":  "Shiny Server",
    "description":  "Server for hosting and serving interactive R Shiny web applications to multiple users over HTTP.",
    "category":  "Developer Tools",
    "image":  "rocker/shiny:latest",
    "logo":  "https://www.google.com/s2/favicons?domain=posit.co\u0026sz=128",
    "website":  "https://posit.co/products/open-source/shiny-server/",
    "docsUrl":  "https://rocker-project.org/images/versioned/shiny.html",
    "ports":  [
                  {
                      "host":  3838,
                      "container":  3838,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/shiny-server/apps",
                        "container":  "/srv/shiny-server"
                    },
                    {
                        "host":  "/opt/appdata/shiny-server/logs",
                        "container":  "/var/log/shiny-server"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "minMemory":  "512MB",
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
