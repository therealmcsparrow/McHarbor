{
    "slug":  "wapiti",
    "name":  "Wapiti",
    "description":  "Black-box web application vulnerability scanner that crawls pages and tests forms for common flaws.",
    "category":  "Security",
    "image":  "cyberwatch/wapiti:latest",
    "logo":  "https://icon.horse/icon/wapiti-scanner.github.io",
    "website":  "https://wapiti-scanner.github.io",
    "docsUrl":  "https://github.com/wapiti-scanner/wapiti#docker",
    "ports":  [

              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/wapiti/report",
                        "container":  "/report"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
