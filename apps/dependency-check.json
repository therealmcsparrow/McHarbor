{
    "slug":  "dependency-check",
    "name":  "OWASP Dependency-Check",
    "description":  "Identifies project dependencies with publicly disclosed vulnerabilities across common language ecosystems.",
    "category":  "Security",
    "image":  "owasp/dependency-check:latest",
    "logo":  "https://cdn.simpleicons.org/dependencycheck",
    "website":  "https://owasp.org/www-project-dependency-check/",
    "docsUrl":  "https://jeremylong.github.io/DependencyCheck/dependency-check-cli/index.html",
    "ports":  [

              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/dependency-check/data",
                        "container":  "/usr/share/dependency-check/data"
                    },
                    {
                        "host":  "/opt/appdata/dependency-check/project",
                        "container":  "/src"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
