{
  "slug": "varnish",
  "name": "Varnish Cache",
  "description": "HTTP accelerator designed for content-heavy dynamic web sites and APIs.",
  "category": "Networking",
  "image": "varnish:latest",
  "logo": "https://www.google.com/s2/favicons?domain=varnish-cache.org\u0026sz=128",
  "website": "https://varnish-cache.org",
  "docsUrl": "https://varnish-cache.org/docs/",
  "ports": [
    {
      "host": 80,
      "container": 80,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "host": "/opt/appdata/varnish/config",
      "container": "/etc/varnish"
    },
    {
      "host": "/opt/appdata/varnish/lib",
      "container": "/var/lib/varnish"
    }
  ],
  "envVars": [
    {
      "key": "TZ",
      "default": "Etc/UTC",
      "description": "Timezone"
    }
  ],
  "version":  "latest",
  "latest":  {
      "version":  "latest",
      "release_date":  "2026-09-10"
  }
}