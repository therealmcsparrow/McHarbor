{
    "slug":  "esphome-web",
    "name":  "ESPHome Web",
    "description":  "ESPHome device manager and dashboard with YAML configuration and OTA updates.",
    "category":  "Home Automation",
    "image":  "esphome/esphome:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/esphome.svg",
    "website":  "https://esphome.io",
    "docsUrl":  "https://esphome.io/guides/getting_started_command_line.html",
    "ports":  [
                  {
                      "host":  6052,
                      "container":  6052,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/esphome-web/config",
                        "container":  "/config"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-10"
    }
}
