{
    "slug":  "victorialogs",
    "name":  "VictoriaLogs",
    "description":  "Fast, cost-efficient log storage and querying engine built by the VictoriaMetrics team.",
    "category":  "Monitoring",
    "image":  "victoriametrics/victoria-logs:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/victorialogs.png",
    "website":  "https://victoriametrics.com/products/victorialogs/",
    "docsUrl":  "https://docs.victoriametrics.com/victorialogs/quickstart/",
    "ports":  [
                  {
                      "host":  9428,
                      "container":  9428,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/victorialogs/data",
                        "container":  "/victoria-logs-data"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    },
    "composeOverride":  "# Generated by McHarbor App Store\nservices:\n  {{serviceName}}:\n    image: {{image}}\n    container_name: {{containerName}}\n    restart: unless-stopped\n{{ports}}\n    command: \"--storageDataPath=/victoria-logs-data --httpListenAddr=:9428\"\n    environment:\n      TZ: {{env.TZ}}\n    volumes:\n      - {{appDataPath}}/data:/victoria-logs-data\n"
}
