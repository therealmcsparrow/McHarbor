{
  "slug": "postgres-15-dev",
  "name": "Postgres 15 Dev",
  "description": "PostgreSQL 15 on Alpine for development and testing.",
  "category": "Databases",
  "image": "postgres:15-alpine",
  "logo": "https://www.postgresql.org/media/img/about/press/elephant.png",
  "website": "https://www.postgresql.org",
  "docsUrl": "https://www.postgresql.org/docs/15/",
  "ports": [
    {
      "host": 5432,
      "container": 5432,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "host": "/opt/appdata/postgres-15-dev/data",
      "container": "/var/lib/postgresql/data"
    }
  ],
  "envVars": [
    {
      "key": "POSTGRES_USER",
      "default": "postgres",
      "description": "Database superuser name"
    },
    {
      "key": "POSTGRES_PASSWORD",
      "default": "",
      "description": "Database superuser password",
      "secret": true
    },
    {
      "key": "POSTGRES_DB",
      "default": "dev",
      "description": "Default database name"
    }
  ],
  "version": "15-alpine"
}
