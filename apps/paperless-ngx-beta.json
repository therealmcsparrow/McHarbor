{
    "slug":  "paperless-ngx-beta",
    "name":  "Paperless-ngx (Beta)",
    "description":  "Beta channel build of Paperless-ngx. Document management system that transforms physical documents into a searchable archive.",
    "category":  "Productivity",
    "image":  "ghcr.io/paperless-ngx/paperless-ngx:beta",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/paperless-ngx.svg",
    "website":  "https://docs.paperless-ngx.com",
    "docsUrl":  "https://docs.paperless-ngx.com",
    "ports":  [
                  {
                      "host":  9000,
                      "container":  8000,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/paperless/data",
                        "container":  "/usr/src/paperless/data"
                    },
                    {
                        "host":  "/opt/appdata/paperless/media",
                        "container":  "/usr/src/paperless/media"
                    },
                    {
                        "host":  "/opt/appdata/paperless/consume",
                        "container":  "/usr/src/paperless/consume"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    },
                    {
                        "key":  "PAPERLESS_SECRET_KEY",
                        "default":  "",
                        "description":  "Secret key for sessions",
                        "secret":  true
                    },
                    {
                        "key":  "PAPERLESS_ADMIN_USER",
                        "default":  "admin",
                        "description":  "Admin username"
                    },
                    {
                        "key":  "PAPERLESS_ADMIN_PASSWORD",
                        "default":  "",
                        "description":  "Admin password",
                        "secret":  true
                    }
                ],
    "version":  "beta",
    "latest":  {
        "version":  "beta",
        "release_date":  "2026-09-29"
    }
}
