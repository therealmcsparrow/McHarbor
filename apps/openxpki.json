{
    "slug":  "openxpki",
    "name":  "OpenXPKI",
    "description":  "Enterprise-grade PKI trustcenter software for managing certificate issuance workflows and CRL/OCSP services.",
    "category":  "Security",
    "image":  "whiterabbitsecurity/openxpki:latest",
    "logo":  "https://icon.horse/icon/www.openxpki.org",
    "website":  "https://www.openxpki.org",
    "docsUrl":  "https://github.com/openxpki/openxpki-docker",
    "ports":  [
                  {
                      "host":  8446,
                      "container":  8443,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/openxpki/config",
                        "container":  "/etc/openxpki"
                    },
                    {
                        "host":  "/opt/appdata/openxpki/data",
                        "container":  "/var/lib/openxpki"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "minMemory":  "1GB",
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
