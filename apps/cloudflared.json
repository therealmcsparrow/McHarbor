    "description":  "Cloudflare Tunnel connector for exposing homelab services safely.",
    "category":  "Networking",
    "image":  "cloudflare/cloudflared:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/cloudflared.png",
    "website":  "https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/",
    "docsUrl":  "https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/",
    "ports":  [

              ],
    "volumes":  [

                ],
    "envVars":  [
                    {
                        "key":  "TUNNEL_TOKEN",
                        "default":  "",
                        "description":  "Cloudflare tunnel token",
                        "secret":  true
                    }
                ],
    "version":  "latest",
    "composeOverride":  "# Generated by McHarbor App Store\nservices:\n  {{serviceName}}:\n    image: {{image}}\n    container_name: {{containerName}}\n    restart: unless-stopped\n    command: tunnel --no-autoupdate run --token {{envRaw.TUNNEL_TOKEN}}\n"
}
