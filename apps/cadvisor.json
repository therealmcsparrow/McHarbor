{
  "slug": "cadvisor",
  "name": "cAdvisor",
  "description": "Container resource usage and performance metrics exporter.",
  "category": "Monitoring",
  "image": "gcr.io/cadvisor/cadvisor:latest",
  "logo": "",
  "website": "https://github.com/google/cadvisor",
  "docsUrl": "https://github.com/google/cadvisor",
  "ports": [
    {
      "host": 8080,
      "container": 8080,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "host": "/",
      "container": "/rootfs",
      "readOnly": true
    },
    {
      "host": "/var/run",
      "container": "/var/run",
      "readOnly": true
    },
    {
      "host": "/sys",
      "container": "/sys",
      "readOnly": true
    },
    {
      "host": "/var/lib/docker",
      "container": "/var/lib/docker",
      "readOnly": true
    }
  ],
  "envVars": [
    {
      "key": "TZ",
      "default": "Etc/UTC",
      "description": "Timezone"
    }
  ],
  "version": "latest"
}
