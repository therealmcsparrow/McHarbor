{
    "slug":  "music-assistant-nightly",
    "name":  "Music Assistant (Nightly)",
    "description":  "Nightly channel build of Music Assistant. Tracks pre-release changes and is not recommended for data you cannot lose.",
    "category":  "Media",
    "image":  "ghcr.io/music-assistant/server:nightly",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/music-assistant.png",
    "website":  "https://music-assistant.io",
    "docsUrl":  "https://www.music-assistant.io/installation/",
    "ports":  [

              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/music-assistant-nightly/data",
                        "container":  "/data"
                    },
                    {
                        "host":  "/opt/appdata/music-assistant-nightly/media",
                        "container":  "/media"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    },
                    {
                        "key":  "LOG_LEVEL",
                        "default":  "info",
                        "description":  "Log verbosity: debug, info, warning or error"
                    }
                ],
    "minMemory":  "512MB",
    "version":  "nightly",
    "latest":  {
        "version":  "nightly",
        "release_date":  "2026-09-29"
    },
    "composeOverride":  "# Generated by McHarbor App Store\nservices:\n  {{serviceName}}:\n    image: {{image}}\n    container_name: {{containerName}}\n    restart: unless-stopped\n    network_mode: host\n    cap_add:\n      - SYS_ADMIN\n      - DAC_READ_SEARCH\n    security_opt:\n      - apparmor:unconfined\n{{volumes}}\n{{environment}}\n"
}
