{
  "slug": "wallos",
  "name": "Wallos",
  "description": "Personal subscription tracker for recurring costs, renewals and budgets.",
  "category": "Productivity",
  "image": "bellamy/wallos:latest",
  "logo": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/wallos.png",
  "website": "https://wallosapp.com",
  "docsUrl": "https://github.com/ellite/Wallos#docker",
  "ports": [
    {
      "host": 8282,
      "container": 80,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "host": "/opt/appdata/wallos/db",
      "container": "/var/www/html/db"
    },
    {
      "host": "/opt/appdata/wallos/logos",
      "container": "/var/www/html/images/uploads/logos"
    }
  ],
  "envVars": [
    {
      "key": "TZ",
      "default": "Etc/UTC",
      "description": "Timezone for logs and scheduled tasks"
    }
  ],
  "version": "latest",
  "latest": {
    "version": "latest",
    "release_date": "2026-09-27"
  }
}
