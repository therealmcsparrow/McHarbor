{
    "slug":  "ntopng",
    "name":  "ntopng",
    "description":  "Real-time network traffic monitor showing bandwidth usage and flows by host and protocol.",
    "category":  "Monitoring",
    "image":  "ntop/ntopng:latest",
    "logo":  "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/ntopng.png",
    "website":  "https://www.ntop.org/products/traffic-analysis/ntop/",
    "docsUrl":  "https://www.ntop.org/products/traffic-analysis/ntop/",
    "ports":  [
                  {
                      "host":  3005,
                      "container":  3000,
                      "protocol":  "tcp"
                  }
              ],
    "volumes":  [
                    {
                        "host":  "/opt/appdata/ntopng/data",
                        "container":  "/var/lib/ntopng"
                    }
                ],
    "envVars":  [
                    {
                        "key":  "TZ",
                        "default":  "Etc/UTC",
                        "description":  "Timezone"
                    }
                ],
    "version":  "latest",
    "latest":  {
        "version":  "latest",
        "release_date":  "2026-09-29"
    }
}
