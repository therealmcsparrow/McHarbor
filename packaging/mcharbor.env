DATA_DIR=/var/lib/mcharbor
DATABASE_PATH=/var/lib/mcharbor/mcharbor.db
MCHARBOR_PAYLOAD_DIR=/opt/mcharbor
PORT=8705
DOCKER_HOST=unix:///var/run/docker.sock
MCHARBOR_PLUGIN_TRUST_KEYS=/opt/mcharbor/trust/plugin-signing.pub
MCHARBOR_PLUGIN_CATALOG_ROOT=/opt/mcharbor/ai-plugin-catalog
MCHARBOR_THEME_CATALOG_ROOT=/opt/mcharbor/themes-catalog
MCHARBOR_PLUGIN_CATALOG_DIRS=/opt/mcharbor/ai-plugin-catalog
BACKUP_ENCRYPTION_KEY_FILE=/var/lib/mcharbor/secrets/mcharbor_backup_key
